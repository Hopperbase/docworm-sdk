/span> <span class=\"n\">page_num</span><span class=\"p\">),</span>\n            <span class=\"n\">markdown</span><span class=\"o\">=</span><span class=\"n\">d</span><span class=\"o\">.</span><span class=\"n\">get</span><span class=\"p\">(</span><span class=\"s2\">\"markdown\"</span><span class=\"p\">,</span> <span class=\"s2\">\"\"</span><span class=\"p\">),</span>\n            <span class=\"n\">status</span><span class=\"o\">=</span><span class=\"n\">d</span><span class=\"o\">.</span><span class=\"n\">get</span><span class=\"p\">(</span><span class=\"s2\">\"status\"</span><span class=\"p\">,</span> <span class=\"s2\">\"\"</span><span class=\"p\">),</span>\n        <span class=\"p\">)</span></div>\n\n\n<div class=\"viewcode-block\" id=\"DocWorm.get_page_image\">\n<a class=\"viewcode-back\" href=\"../../../client/#docworm.client.DocWorm.get_page_image\">[docs]</a>\n    <span class=\"k\">def</span><span class=\"w\"> </span><span class=\"nf\">get_page_image</span><span class=\"p\">(</span><span class=\"bp\">self</span><span class=\"p\">,</span> <span class=\"n\">file_id</span><span class=\"p\">:</span> <span class=\"nb\">str</span><span class=\"p\">,</span> <span class=\"n\">page_num</span><span class=\"p\">:</span> <span class=\"nb\">int</span><span class=\"p\">)</span> <span class=\"o\">-&gt;</span> <span class=\"nb\">dict</span><span class=\"p\">:</span>\n<span class=\"w\">        </span><span class=\"sd\">\"\"\"</span>\n<span class=\"sd\">        Get the JPEG bytes for a single page.</span>\n\n<span class=\"sd\">        Returns:</span>\n<span class=\"sd\">            Dict with content (bytes), content_type, and total_pages</span>\n<span class=\"sd\">            (from the X-Total-Pages response header).</span>\n<span class=\"sd\">        \"\"\"</span>\n        <span class=\"n\">resp</span> <span class=\"o\">=</span> <span class=\"n\">httpx</span><span class=\"o\">.</span><span class=\"n\">get</span><span class=\"p\">(</span>\n            <span class=\"sa\">f</span><span class=\"s2\">\"</span><span class=\"si\">{</span><span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">base_url</span><span class=\"si\">}</span><span class=\"s2\">/v1/documents/</span><span class=\"si\">{</span><span class=\"n\">quote</span><span class=\"p\">(</span><span class=\"n\">file_id</span><span class=\"p\">)</span><span class=\"si\">}</span><span class=\"s2\">/pages/</span><span class=\"si\">{</span><span class=\"n\">page_num</span><span class=\"si\">}</span><span class=\"s2\">/image\"</span><span class=\"p\">,</span>\n            <span class=\"n\">headers</span><span class=\"o\">=</span><span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">_headers</span><span class=\"p\">,</span>\n            <span class=\"n\">timeout</span><span class=\"o\">=</span><span class=\"mi\">60</span><span class=\"p\">,</span>\n        <span class=\"p\">)</span>\n        <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">raise_for_status</span><span class=\"p\">()</span>\n        <span class=\"k\">return</span> <span class=\"p\">{</span>\n            <span class=\"s2\">\"content\"</span><span class=\"p\">:</span> <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">content</span><span class=\"p\">,</span>\n            <span class=\"s2\">\"content_type\"</span><span class=\"p\">:</span> <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">headers</span><span class=\"o\">.</span><span class=\"n\">get</span><span class=\"p\">(</span><span class=\"s2\">\"content-type\"</span><span class=\"p\">,</span> <span class=\"s2\">\"image/jpeg\"</span><span class=\"p\">),</span>\n            <span class=\"s2\">\"total_pages\"</span><span class=\"p\">:</span> <span class=\"nb\">int</span><span class=\"p\">(</span><span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">headers</span><span class=\"o\">.</span><span class=\"n\">get</span><span class=\"p\">(</span><span class=\"s2\">\"X-Total-Pages\"</span><span class=\"p\">,</span> <span class=\"mi\">0</span><span class=\"p\">)</span> <span class=\"ow\">or</span> <span class=\"mi\">0</span><span class=\"p\">),</span>\n        <span class=\"p\">}</span></div>\n\n\n<div class=\"viewcode-block\" id=\"DocWorm.get_original\">\n<a class=\"viewcode-back\" href=\"../../../client/#docworm.client.DocWorm.get_original\">[docs]</a>\n    <span class=\"k\">def</span><span class=\"w\"> </span><span class=\"nf\">get_original</span><span class=\"p\">(</span><span class=\"bp\">self</span><span class=\"p\">,</span> <span class=\"n\">file_id</span><span class=\"p\">:</span> <span class=\"nb\">str</span><span class=\"p\">)</span> <span class=\"o\">-&gt;</span> <span class=\"nb\">dict</span><span class=\"p\">:</span>\n<span class=\"w\">        </span><span class=\"sd\">\"\"\"</span>\n<span class=\"sd\">        Download the original uploaded file.</span>\n\n<span class=\"sd\">        Returns:</span>\n<span class=\"sd\">            Dict with content (bytes), content_type, and filename.</span>\n<span class=\"sd\">        \"\"\"</span>\n        <span class=\"n\">resp</span> <span class=\"o\">=</span> <span class=\"n\">httpx</span><span class=\"o\">.</span><span class=\"n\">get</span><span class=\"p\">(</span>\n            <span class=\"sa\">f</span><span class=\"s2\">\"</span><span class=\"si\">{</span><span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">base_url</span><span class=\"si\">}</span><span class=\"s2\">/v1/documents/</span><span class=\"si\">{</span><span class=\"n\">quote</span><span class=\"p\">(</span><span class=\"n\">file_id</span><span class=\"p\">)</span><span class=\"si\">}</span><span class=\"s2\">/original\"</span><span class=\"p\">,</span>\n            <span class=\"n\">headers</span><span class=\"o\">=</span><span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">_headers</span><span class=\"p\">,</span>\n            <span class=\"n\">timeout</span><span class=\"o\">=</span><span class=\"mi\">120</span><span class=\"p\">,</span>\n        <span class=\"p\">)</span>\n        <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">raise_for_status</span><span class=\"p\">()</span>\n        <span class=\"k\">return</span> <span class=\"p\">{</span>\n            <span class=\"s2\">\"content\"</span><span class=\"p\">:</span> <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">content</span><span class=\"p\">,</span>\n            <span class=\"s2\">\"content_type\"</span><span class=\"p\">:</span> <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">headers</span><span class=\"o\">.</span><span class=\"n\">get</span><span class=\"p\">(</span><span class=\"s2\">\"content-type\"</span><span class=\"p\">,</span> <span class=\"s2\">\"application/octet-stream\"</span><span class=\"p\">),</span>\n            <span class=\"s2\">\"filename\"</span><span class=\"p\">:</span> <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">headers</span><span class=\"o\">.</span><span class=\"n\">get</span><span class=\"p\">(</span><span class=\"s2\">\"content-disposition\"</span><span class=\"p\">,</span> <span class=\"s2\">\"\"</span><span class=\"p\">),</span>\n        <span class=\"p\">}</span></div>\n\n\n<div class=\"viewcode-block\" id=\"DocWorm.get_document_tree\">\n<a class=\"viewcode-back\" href=\"../../../client/#docworm.client.DocWorm.get_document_tree\">[docs]</a>\n    <span class=\"k\">def</span><span class=\"w\"> </span><span class=\"nf\">get_document_tree</span><span class=\"p\">(</span><span class=\"bp\">self</span><span class=\"p\">,</span> <span class=\"n\">file_id</span><span class=\"p\">:</span> <span class=\"nb\">str</span><span class=\"p\">,</span> <span class=\"n\">download</span><span class=\"p\">:</span> <span class=\"nb\">bool</span> <span class=\"o\">=</span> <span class=\"kc\">False</span><span class=\"p\">)</span> <span class=\"o\">-&gt;</span> <span class=\"nb\">list</span><span class=\"p\">[</span><span class=\"n\">TreeNode</span><span class=\"p\">]:</span>\n<span class=\"w\">        </span><span class=\"sd\">\"\"\"</span>\n<span class=\"sd\">        Get the assembled document tree.</span>\n<span class=\"sd\">        \"\"\"</span>\n        <span class=\"n\">params</span> <span class=\"o\">=</span> <span class=\"p\">{</span><span class=\"s2\">\"download\"</span><span class=\"p\">:</span> <span class=\"s2\">\"true\"</span><span class=\"p\">}</span> <span class=\"k\">if</span> <span class=\"n\">download</span> <span class=\"k\">else</span> <span class=\"kc\">None</span>\n        <span class=\"n\">resp</span> <span class=\"o\">=</span> <span class=\"n\">httpx</span><span class=\"o\">.</span><span class=\"n\">get</span><span class=\"p\">(</span>\n            <span class=\"sa\">f</span><span class=\"s2\">\"</span><span class=\"si\">{</span><span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">base_url</span><span class=\"si\">}</span><span class=\"s2\">/v1/documents/</span><span class=\"si\">{</span><span class=\"n\">quote</span><span class=\"p\">(</span><span class=\"n\">file_id</span><span class=\"p\">)</span><span class=\"si\">}</span><span class=\"s2\">/tree\"</span><span class=\"p\">,</span>\n            <span class=\"n\">params</span><span class=\"o\">=</span><span class=\"n\">params</span><span class=\"p\">,</span>\n            <span class=\"n\">headers</span><span class=\"o\">=</span><span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">_headers</span><span class=\"p\">,</span>\n            <span class=\"n\">timeout</span><span class=\"o\">=</span><span class=\"mi\">60</span><span class=\"p\">,</span>\n        <span class=\"p\">)</span>\n        <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">raise_for_status</span><span class=\"p\">()</span>\n        <span class=\"k\">return</span> <span class=\"p\">[</span><span class=\"n\">tree_node_from_dict</span><span class=\"p\">(</span><span class=\"n\">n</span><span class=\"p\">)</span> <span class=\"k\">for</span> <span class=\"n\">n</span> <span class=\"ow\">in</span> <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">json</span><span class=\"p\">()</span><span class=\"o\">.</span><span class=\"n\">get</span><span class=\"p\">(</span><span class=\"s2\">\"tree\"</span><span class=\"p\">,</span> <span class=\"p\">[])]</span></div>\n\n\n<div class=\"viewcode-block\" id=\"DocWorm.get_node_map\">\n<a class=\"viewcode-back\" href=\"../../../client/#docworm.client.DocWorm.get_node_map\">[docs]</a>\n    <span class=\"k\">def</span><span class=\"w\"> </span><span class=\"nf\">get_node_map</span><span class=\"p\">(</span><span class=\"bp\">self</span><span class=\"p\">,</span> <span class=\"n\">file_id</span><span class=\"p\">:</span> <span class=\"nb\">str</span><span class=\"p\">,</span> <span class=\"n\">download</span><span class=\"p\">:</span> <span class=\"nb\">bool</span> <span class=\"o\">=</span> <span class=\"kc\">False</span><span class=\"p\">)</span> <span class=\"o\">-&gt;</span> <span class=\"nb\">dict</span><span class=\"p\">:</span>\n<span class=\"w\">        </span><span class=\"sd\">\"\"\"</span>\n<span class=\"sd\">        Get the flat node-id \u2192 node map for a document.</span>\n<span class=\"sd\">        \"\"\"</span>\n        <span class=\"n\">params</span> <span class=\"o\">=</span> <span class=\"p\">{</span><span class=\"s2\">\"download\"</span><span class=\"p\">:</span> <span class=\"s2\">\"true\"</span><span class=\"p\">}</span> <span class=\"k\">if</span> <span class=\"n\">download</span> <span class=\"k\">else</span> <span class=\"kc\">None</span>\n        <span class=\"n\">resp</span> <span class=\"o\">=</span> <span class=\"n\">httpx</span><span class=\"o\">.</span><span class=\"n\">get</span><span class=\"p\">(</span>\n            <span class=\"sa\">f</span><span class=\"s2\">\"</span><span class=\"si\">{</span><span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">base_url</span><span class=\"si\">}</span><span class=\"s2\">/v1/documents/</span><span class=\"si\">{</span><span class=\"n\">quote</span><span class=\"p\">(</span><span class=\"n\">file_id</span><span class=\"p\">)</span><span class=\"si\">}</span><span class=\"s2\">/node-map\"</span><span class=\"p\">,</span>\n            <span class=\"n\">params</span><span class=\"o\">=</span><span class=\"n\">params</span><span class=\"p\">,</span>\n            <span class=\"n\">headers</span><span class=\"o\">=</span><span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">_headers</span><span class=\"p\">,</span>\n            <span class=\"n\">timeout</span><span class=\"o\">=</span><span class=\"mi\">60</span><span class=\"p\">,</span>\n        <span class=\"p\">)</span>\n        <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">raise_for_status</span><span class=\"p\">()</span>\n        <span class=\"k\">return</span> <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">json</span><span class=\"p\">()</span><span class=\"o\">.</span><span class=\"n\">get</span><span class=\"p\">(</span><span class=\"s2\">\"node_map\"</span><span class=\"p\">,</span> <span class=\"p\">{})</span></div>\n\n\n<div class=\"viewcode-block\" id=\"DocWorm.get_excel_preview\">\n<a class=\"viewcode-back\" href=\"../../../client/#docworm.client.DocWorm.get_excel_preview\">[docs]</a>\n    <span class=\"k\">def</span><span class=\"w\"> </span><span class=\"nf\">get_excel_preview</span><span class=\"p\">(</span><span class=\"bp\">self</span><span class=\"p\">,</span> <span class=\"n\">file_id</span><span class=\"p\">:</span> <span class=\"nb\">str</span><span class=\"p\">)</span> <span class=\"o\">-&gt;</span> <span class=\"nb\">dict</span><span class=\"p\">:</span>\n<span class=\"w\">        </span><span class=\"sd\">\"\"\"</span>\n<span class=\"sd\">        Preview every sheet of an Excel file (headers + first rows).</span>\n\n<span class=\"sd\">        Returns:</span>\n<span class=\"sd\">            Dict with fileId, filename, and sheets list.</span>\n<span class=\"sd\">        \"\"\"</span>\n        <span class=\"n\">resp</span> <span class=\"o\">=</span> <span class=\"n\">httpx</span><span class=\"o\">.</span><span class=\"n\">get</span><span class=\"p\">(</span>\n            <span class=\"sa\">f</span><span class=\"s2\">\"</span><span class=\"si\">{</span><span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">base_url</span><span class=\"si\">}</span><span class=\"s2\">/v1/documents/</span><span class=\"si\">{</span><span class=\"n\">quote</span><span class=\"p\">(</span><span class=\"n\">file_id</span><span class=\"p\">)</span><span class=\"si\">}</span><span class=\"s2\">/excel-preview\"</span><span class=\"p\">,</span>\n            <span class=\"n\">headers</span><span class=\"o\">=</span><span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">_headers</span><span class=\"p\">,</span>\n            <span class=\"n\">timeout</span><span class=\"o\">=</span><span class=\"mi\">60</span><span class=\"p\">,</span>\n        <span class=\"p\">)</span>\n        <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">raise_for_status</span><span class=\"p\">()</span>\n        <span class=\"k\">return</span> <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">json</span><span class=\"p\">()</span></div>\n\n\n<div class=\"viewcode-block\" id=\"DocWorm.delete_document\">\n<a class=\"viewcode-back\" href=\"../../../client/#docworm.client.DocWorm.delete_document\">[docs]</a>\n    <span class=\"k\">def</span><span class=\"w\"> </span><span class=\"nf\">delete_document</span><span class=\"p\">(</span><span class=\"bp\">self</span><span class=\"p\">,</span> <span class=\"n\">file_id</span><span class=\"p\">:</span> <span class=\"nb\">str</span><span class=\"p\">)</span> <span class=\"o\">-&gt;</span> <span class=\"nb\">dict</span><span class=\"p\">:</span>\n<span class=\"w\">        </span><span class=\"sd\">\"\"\"</span>\n<span class=\"sd\">        Delete a document and all its artifacts (GCS, Firestore).</span>\n<span class=\"sd\">        \"\"\"</span>\n        <span class=\"n\">resp</span> <span class=\"o\">=</span> <span class=\"n\">httpx</span><span class=\"o\">.</span><span class=\"n\">delete</span><span class=\"p\">(</span>\n            <span class=\"sa\">f</span><span class=\"s2\">\"</span><span class=\"si\">{</span><span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">base_url</span><span class=\"si\">}</span><span class=\"s2\">/v1/documents/</span><span class=\"si\">{</span><span class=\"n\">quote</span><span class=\"p\">(</span><span class=\"n\">file_id</span><span class=\"p\">)</span><span class=\"si\">}</span><span class=\"s2\">\"</span><span class=\"p\">,</span>\n            <span class=\"n\">headers</span><span class=\"o\">=</span><span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">_headers</span><span class=\"p\">,</span>\n            <span class=\"n\">timeout</span><span class=\"o\">=</span><span class=\"mi\">30</span><span class=\"p\">,</span>\n        <span class=\"p\">)</span>\n        <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">raise_for_status</span><span class=\"p\">()</span>\n        <span class=\"k\">return</span> <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">json</span><span class=\"p\">()</span></div>\n\n\n<div class=\"viewcode-block\" id=\"DocWorm.delete_file\">\n<a class=\"viewcode-back\" href=\"../../../client/#docworm.client.DocWorm.delete_file\">[docs]</a>\n    <span class=\"k\">def</span><span class=\"w\"> </span><span class=\"nf\">delete_file</span><span class=\"p\">(</span><span class=\"bp\">self</span><span class=\"p\">,</span> <span class=\"n\">file_id</span><span class=\"p\">:</span> <span class=\"nb\">str</span><span class=\"p\">)</span> <span class=\"o\">-&gt;</span> <span class=\"nb\">dict</span><span class=\"p\">:</span>\n<span class=\"w\">        </span><span class=\"sd\">\"\"\"</span>\n<span class=\"sd\">        Alias of delete_document via DELETE /v1/files/{file_id}.</span>\n<span class=\"sd\">        \"\"\"</span>\n        <span class=\"n\">resp</span> <span class=\"o\">=</span> <span class=\"n\">httpx</span><span class=\"o\">.</span><span class=\"n\">delete</span><span class=\"p\">(</span>\n            <span class=\"sa\">f</span><span class=\"s2\">\"</span><span class=\"si\">{</span><span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">base_url</span><span class=\"si\">}</span><span class=\"s2\">/v1/files/</span><span class=\"si\">{</span><span class=\"n\">quote</span><span class=\"p\">(</span><span class=\"n\">file_id</span><span class=\"p\">)</span><span class=\"si\">}</span><span class=\"s2\">\"</span><span class=\"p\">,</span>\n            <span class=\"n\">headers</span><span class=\"o\">=</span><span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">_headers</span><span class=\"p\">,</span>\n            <span class=\"n\">timeout</span><span class=\"o\">=</span><span class=\"mi\">30</span><span class=\"p\">,</span>\n        <span class=\"p\">)</span>\n        <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">raise_for_status</span><span class=\"p\">()</span>\n        <span class=\"k\">return</span> <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">json</span><span class=\"p\">()</span></div>\n\n\n<div class=\"viewcode-block\" id=\"DocWorm.reprocess_document\">\n<a class=\"viewcode-back\" href=\"../../../client/#docworm.client.DocWorm.reprocess_document\">[docs]</a>\n    <span class=\"k\">def</span><span class=\"w\"> </span><span class=\"nf\">reprocess_document</span><span class=\"p\">(</span><span class=\"bp\">self</span><span class=\"p\">,</span> <span class=\"n\">file_id</span><span class=\"p\">:</span> <span class=\"nb\">str</span><span class=\"p\">)</span> <span class=\"o\">-&gt;</span> <span class=\"nb\">dict</span><span class=\"p\">:</span>\n<span class=\"w\">        </span><span class=\"sd\">\"\"\"</span>\n<span class=\"sd\">        Reprocess an entire document (redo extraction).</span>\n<span class=\"sd\">        \"\"\"</span>\n        <span class=\"n\">resp</span> <span class=\"o\">=</span> <span class=\"n\">httpx</span><span class=\"o\">.</span><span class=\"n\">post</span><span class=\"p\">(</span>\n            <span class=\"sa\">f</span><span class=\"s2\">\"</span><span class=\"si\">{</span><span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">base_url</span><span class=\"si\">}</span><span class=\"s2\">/v1/documents/</span><span class=\"si\">{</span><span class=\"n\">quote</span><span class=\"p\">(</span><span class=\"n\">file_id</span><span class=\"p\">)</span><span class=\"si\">}</span><span class=\"s2\">/reprocess\"</span><span class=\"p\">,</span>\n            <span class=\"n\">headers</span><span class=\"o\">=</span><span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">_headers</span><span class=\"p\">,</span>\n            <span class=\"n\">timeout</span><span class=\"o\">=</span><span class=\"mi\">60</span><span class=\"p\">,</span>\n        <span class=\"p\">)</span>\n        <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">raise_for_status</span><span class=\"p\">()</span>\n        <span class=\"k\">return</span> <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">json</span><span class=\"p\">()</span></div>\n\n\n    <span class=\"c1\"># \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550</span>\n    <span class=\"c1\"># CHATS</span>\n    <span class=\"c1\"># \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550</span>\n\n<div class=\"viewcode-block\" id=\"DocWorm.create_chat\">\n<a class=\"viewcode-back\" href=\"../../../client/#docworm.client.DocWorm.create_chat\">[docs]</a>\n    <span class=\"k\">def</span><span class=\"w\"> </span><span class=\"nf\">create_chat</span><span class=\"p\">(</span>\n        <span class=\"bp\">self</span><span class=\"p\">,</span>\n        <span class=\"n\">chat_id</span><span class=\"p\">:</span> <span class=\"nb\">str</span><span class=\"p\">,</span>\n        <span class=\"n\">title</span><span class=\"p\">:</span> <span class=\"nb\">str</span> <span class=\"o\">=</span> <span class=\"s2\">\"\"</span><span class=\"p\">,</span>\n        <span class=\"n\">display_name</span><span class=\"p\">:</span> <span class=\"nb\">str</span> <span class=\"o\">=</span> <span class=\"s2\">\"\"</span><span class=\"p\">,</span>\n        <span class=\"n\">project_id</span><span class=\"p\">:</span> <span class=\"nb\">str</span> <span class=\"o\">=</span> <span class=\"s2\">\"\"</span><span class=\"p\">,</span>\n        <span class=\"n\">model</span><span class=\"p\">:</span> <span class=\"nb\">str</span> <span class=\"o\">=</span> <span class=\"s2\">\"\"</span><span class=\"p\">,</span>\n    <span class=\"p\">)</span> <span class=\"o\">-&gt;</span> <span class=\"n\">ChatInfo</span><span class=\"p\">:</span>\n<span class=\"w\">        </span><span class=\"sd\">\"\"\"</span>\n<span class=\"sd\">        Create a new chat. Idempotent \u2014 returns the existing chat id</span>\n<span class=\"sd\">        when it already exists.</span>\n<span class=\"sd\">        \"\"\"</span>\n        <span class=\"n\">body</span><span class=\"p\">:</span> <span class=\"nb\">dict</span> <span class=\"o\">=</span> <span class=\"p\">{</span><span class=\"s2\">\"chatId\"</span><span class=\"p\">:</span> <span class=\"n\">chat_id</span><span class=\"p\">}</span>\n        <span class=\"k\">if</span> <span class=\"n\">title</span><span class=\"p\">:</span>\n            <span class=\"n\">body</span><span class=\"p\">[</span><span class=\"s2\">\"title\"</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"n\">title</span>\n        <span class=\"k\">if</span> <span class=\"n\">display_name</span><span class=\"p\">:</span>\n            <span class=\"n\">body</span><span class=\"p\">[</span><span class=\"s2\">\"display_name\"</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"n\">display_name</span>\n        <span class=\"k\">if</span> <span class=\"n\">project_id</span><span class=\"p\">:</span>\n            <span class=\"n\">body</span><span class=\"p\">[</span><span class=\"s2\">\"project_id\"</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"n\">project_id</span>\n        <span class=\"k\">if</span> <span class=\"n\">model</span><span class=\"p\">:</span>\n            <span class=\"n\">body</span><span class=\"p\">[</span><span class=\"s2\">\"model\"</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"n\">model</span>\n        <span class=\"n\">resp</span> <span class=\"o\">=</span> <span class=\"n\">httpx</span><span class=\"o\">.</span><span class=\"n\">post</span><span class=\"p\">(</span>\n            <span class=\"sa\">f</span><span class=\"s2\">\"</span><span class=\"si\">{</span><span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">base_url</span><span class=\"si\">}</span><span class=\"s2\">/v1/chats\"</span><span class=\"p\">,</span>\n            <span class=\"n\">json</span><span class=\"o\">=</span><span class=\"n\">body</span><span class=\"p\">,</span>\n            <span class=\"n\">headers</span><span class=\"o\">=</span><span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">_headers</span><span class=\"p\">,</span>\n            <span class=\"n\">timeout</span><span class=\"o\">=</span><span class=\"mi\">30</span><span class=\"p\">,</span>\n        <span class=\"p\">)</span>\n        <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">raise_for_status</span><span class=\"p\">()</span>\n        <span class=\"n\">d</span> <span class=\"o\">=</span> <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">json</span><span class=\"p\">()</span>\n        <span class=\"k\">return</span> <span class=\"n\">ChatInfo</span><span class=\"p\">(</span>\n            <span class=\"nb\">id</span><span class=\"o\">=</span><span class=\"n\">d</span><span class=\"o\">.</span><span class=\"n\">get</span><span class=\"p\">(</span><span class=\"s2\">\"id\"</span><span class=\"p\">,</span> <span class=\"n\">chat_id</span><span class=\"p\">),</span>\n            <span class=\"n\">chat_id</span><span class=\"o\">=</span><span class=\"n\">chat_id</span><span class=\"p\">,</span>\n            <span class=\"n\">display_name</span><span class=\"o\">=</span><span class=\"n\">d</span><span class=\"o\">.</span><span class=\"n\">get</span><span class=\"p\">(</span><span class=\"s2\">\"display_name\"</span><span class=\"p\">,</span> <span class=\"s2\">\"\"</span><span class=\"p\">),</span>\n            <span class=\"n\">created_at</span><span class=\"o\">=</span><span class=\"nb\">str</span><span class=\"p\">(</span><span class=\"n\">d</span><span class=\"o\">.</span><span class=\"n\">get</span><span class=\"p\">(</span><span class=\"s2\">\"created_at\"</span><span class=\"p\">,</span> <span class=\"s2\">\"\"</span><span class=\"p\">)</span> <span class=\"ow\">or</span> <span class=\"s2\">\"\"</span><span class=\"p\">),</span>\n        <span class=\"p\">)</span></div>\n\n\n<div class=\"viewcode-block\" id=\"DocWorm.get_chat\">\n<a class=\"viewcode-back\" href=\"../../../client/#docworm.client.DocWorm.get_chat\">[docs]</a>\n    <span class=\"k\">def</span><span class=\"w\"> </span><span class=\"nf\">get_chat</span><span class=\"p\">(</span><span class=\"bp\">self</span><span class=\"p\">,</span> <span class=\"n\">chat_id</span><span class=\"p\">:</span> <span class=\"nb\">str</span><span class=\"p\">)</span> <span class=\"o\">-&gt;</span> <span class=\"nb\">dict</span><span class=\"p\">:</span>\n<span class=\"w\">        </span><span class=\"sd\">\"\"\"Get chat details.\"\"\"</span>\n        <span class=\"n\">resp</span> <span class=\"o\">=</span> <span class=\"n\">httpx</span><span class=\"o\">.</span><span class=\"n\">get</span><span class=\"p\">(</span>\n            <span class=\"sa\">f</span><span class=\"s2\">\"</span><span class=\"si\">{</span><span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">base_url</span><span class=\"si\">}</span><span class=\"s2\">/v1/chats/</span><span class=\"si\">{</span><span class=\"n\">quote</span><span class=\"p\">(</span><span class=\"n\">chat_id</span><span class=\"p\">)</span><span class=\"si\">}</span><span class=\"s2\">\"</span><span class=\"p\">,</span>\n            <span class=\"n\">headers</span><span class=\"o\">=</span><span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">_headers</span><span class=\"p\">,</span>\n            <span class=\"n\">timeout</span><span class=\"o\">=</span><span class=\"mi\">30</span><span class=\"p\">,</span>\n        <span class=\"p\">)</span>\n        <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">raise_for_status</span><span class=\"p\">()</span>\n        <span class=\"k\">return</span> <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">json</span><span class=\"p\">()</span></div>\n\n\n<div class=\"viewcode-block\" id=\"DocWorm.update_chat\">\n<a class=\"viewcode-back\" href=\"../../../client/#docworm.client.DocWorm.update_chat\">[docs]</a>\n    <span class=\"k\">def</span><span class=\"w\"> </span><span class=\"nf\">update_chat</span><span class=\"p\">(</span>\n        <span class=\"bp\">self</span><span class=\"p\">,</span>\n        <span class=\"n\">chat_id</span><span class=\"p\">:</span> <span class=\"nb\">str</span><span class=\"p\">,</span>\n        <span class=\"n\">title</span><span class=\"p\">:</span> <span class=\"n\">Optional</span><span class=\"p\">[</span><span class=\"nb\">str</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"kc\">None</span><span class=\"p\">,</span>\n        <span class=\"n\">display_name</span><span class=\"p\">:</span> <span class=\"n\">Optional</span><span class=\"p\">[</span><span class=\"nb\">str</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"kc\">None</span><span class=\"p\">,</span>\n        <span class=\"n\">model</span><span class=\"p\">:</span> <span class=\"n\">Optional</span><span class=\"p\">[</span><span class=\"nb\">str</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"kc\">None</span><span class=\"p\">,</span>\n    <span class=\"p\">)</span> <span class=\"o\">-&gt;</span> <span class=\"nb\">dict</span><span class=\"p\">:</span>\n<span class=\"w\">        </span><span class=\"sd\">\"\"\"Update chat metadata (title, display_name, model).\"\"\"</span>\n        <span class=\"n\">body</span><span class=\"p\">:</span> <span class=\"nb\">dict</span> <span class=\"o\">=</span> <span class=\"p\">{}</span>\n        <span class=\"k\">if</span> <span class=\"n\">title</span> <span class=\"ow\">is</span> <span class=\"ow\">not</span> <span class=\"kc\">None</span><span class=\"p\">:</span>\n            <span class=\"n\">body</span><span class=\"p\">[</span><span class=\"s2\">\"title\"</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"n\">title</span>\n        <span class=\"k\">if</span> <span class=\"n\">display_name</span> <span class=\"ow\">is</span> <span class=\"ow\">not</span> <span class=\"kc\">None</span><span class=\"p\">:</span>\n            <span class=\"n\">body</span><span class=\"p\">[</span><span class=\"s2\">\"display_name\"</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"n\">display_name</span>\n        <span class=\"k\">if</span> <span class=\"n\">model</span> <span class=\"ow\">is</span> <span class=\"ow\">not</span> <span class=\"kc\">None</span><span class=\"p\">:</span>\n            <span class=\"n\">body</span><span class=\"p\">[</span><span class=\"s2\">\"model\"</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"n\">model</span>\n        <span class=\"n\">resp</span> <span class=\"o\">=</span> <span class=\"n\">httpx</span><span class=\"o\">.</span><span class=\"n\">patch</span><span class=\"p\">(</span>\n            <span class=\"sa\">f</span><span class=\"s2\">\"</span><span class=\"si\">{</span><span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">base_url</span><span class=\"si\">}</span><span class=\"s2\">/v1/chats/</span><span class=\"si\">{</span><span class=\"n\">quote</span><span class=\"p\">(</span><span class=\"n\">chat_id</span><span class=\"p\">)</span><span class=\"si\">}</span><span class=\"s2\">\"</span><span class=\"p\">,</span>\n            <span class=\"n\">json</span><span class=\"o\">=</span><span class=\"n\">body</span><span class=\"p\">,</span>\n            <span class=\"n\">headers</span><span class=\"o\">=</span><span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">_headers</span><span class=\"p\">,</span>\n            <span class=\"n\">timeout</span><span class=\"o\">=</span><span class=\"mi\">30</span><span class=\"p\">,</span>\n        <span class=\"p\">)</span>\n        <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">raise_for_status</span><span class=\"p\">()</span>\n        <span class=\"k\">return</span> <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">json</span><span class=\"p\">()</span></div>\n\n\n<div class=\"viewcode-block\" id=\"DocWorm.delete_chat\">\n<a class=\"viewcode-back\" href=\"../../../client/#docworm.client.DocWorm.delete_chat\">[docs]</a>\n    <span class=\"k\">def</span><span class=\"w\"> </span><span class=\"nf\">delete_chat</span><span class=\"p\">(</span><span class=\"bp\">self</span><span class=\"p\">,</span> <span class=\"n\">chat_id</span><span class=\"p\">:</span> <span class=\"nb\">str</span><span class=\"p\">)</span> <span class=\"o\">-&gt;</span> <span class=\"nb\">dict</span><span class=\"p\">:</span>\n<span class=\"w\">        </span><span class=\"sd\">\"\"\"Delete a chat and its message history.\"\"\"</span>\n        <span class=\"n\">resp</span> <span class=\"o\">=</span> <span class=\"n\">httpx</span><span class=\"o\">.</span><span class=\"n\">delete</span><span class=\"p\">(</span>\n            <span class=\"sa\">f</span><span class=\"s2\">\"</span><span class=\"si\">{</span><span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">base_url</span><span class=\"si\">}</span><span class=\"s2\">/v1/chats/</span><span class=\"si\">{</span><span class=\"n\">quote</span><span class=\"p\">(</span><span class=\"n\">chat_id</span><span class=\"p\">)</span><span class=\"si\">}</span><span class=\"s2\">\"</span><span class=\"p\">,</span>\n            <span class=\"n\">headers</span><span class=\"o\">=</span><span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">_headers</span><span class=\"p\">,</span>\n            <span class=\"n\">timeout</span><span class=\"o\">=</span><span class=\"mi\">30</span><span class=\"p\">,</span>\n        <span class=\"p\">)</span>\n        <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">raise_for_status</span><span class=\"p\">()</span>\n        <span class=\"k\">return</span> <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">json</span><span class=\"p\">()</span></div>\n\n\n<div class=\"viewcode-block\" id=\"DocWorm.list_chats\">\n<a class=\"viewcode-back\" href=\"../../../client/#docworm.client.DocWorm.list_chats\">[docs]</a>\n    <span class=\"k\">def</span><span class=\"w\"> </span><span class=\"nf\">list_chats</span><span class=\"p\">(</span><span class=\"bp\">self</span><span class=\"p\">)</span> <span class=\"o\">-&gt;</span> <span class=\"nb\">list</span><span class=\"p\">[</span><span class=\"nb\">dict</span><span class=\"p\">]:</span>\n<span class=\"w\">        </span><span class=\"sd\">\"\"\"List all chats for the current user.\"\"\"</span>\n        <span class=\"n\">resp</span> <span class=\"o\">=</span> <span class=\"n\">httpx</span><span class=\"o\">.</span><span class=\"n\">get</span><span class=\"p\">(</span>\n            <span class=\"sa\">f</span><span class=\"s2\">\"</span><span class=\"si\">{</span><span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">base_url</span><span class=\"si\">}</span><span class=\"s2\">/v1/chats\"</span><span class=\"p\">,</span>\n            <span class=\"n\">headers</span><span class=\"o\">=</span><span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">_headers</span><span class=\"p\">,</span>\n            <span class=\"n\">timeout</span><span class=\"o\">=</span><span class=\"mi\">30</span><span class=\"p\">,</span>\n        <span class=\"p\">)</span>\n        <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">raise_for_status</span><span class=\"p\">()</span>\n        <span class=\"k\">return</span> <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">json</span><span class=\"p\">()</span><span class=\"o\">.</span><span class=\"n\">get</span><span class=\"p\">(</span><span class=\"s2\">\"chats\"</span><span class=\"p\">,</span> <span class=\"p\">[])</span></div>\n\n\n<div class=\"viewcode-block\" id=\"DocWorm.attach_documents\">\n<a class=\"viewcode-back\" href=\"../../../client/#docworm.client.DocWorm.attach_documents\">[docs]</a>\n    <span class=\"k\">def</span><span class=\"w\"> </span><span class=\"nf\">attach_documents</span><span class=\"p\">(</span><span class=\"bp\">self</span><span class=\"p\">,</span> <span class=\"n\">chat_id</span><span class=\"p\">:</span> <span class=\"nb\">str</span><span class=\"p\">,</span> <span class=\"n\">file_ids</span><span class=\"p\">:</span> <span class=\"nb\">list</span><span class=\"p\">[</span><span class=\"nb\">str</span><span class=\"p\">])</span> <span class=\"o\">-&gt;</span> <span class=\"nb\">dict</span><span class=\"p\">:</span>\n<span class=\"w\">        </span><span class=\"sd\">\"\"\"</span>\n<span class=\"sd\">        Attach indexed documents to a chat. Rebuilds the chat's</span>\n<span class=\"sd\">        knowledge graph.</span>\n\n<span class=\"sd\">        Returns:</span>\n<span class=\"sd\">            Dict with chat_id and attachments list.</span>\n<span class=\"sd\">        \"\"\"</span>\n        <span class=\"n\">resp</span> <span class=\"o\">=</span> <span class=\"n\">httpx</span><span class=\"o\">.</span><span class=\"n\">post</span><span class=\"p\">(</span>\n            <span class=\"sa\">f</span><span class=\"s2\">\"</span><span class=\"si\">{</span><span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">base_url</span><span class=\"si\">}</span><span class=\"s2\">/v1/chats/</span><span class=\"si\">{</span><span class=\"n\">quote</span><span class=\"p\">(</span><span class=\"n\">chat_id</span><span class=\"p\">)</span><span class=\"si\">}</span><span class=\"s2\">/attach\"</span><span class=\"p\">,</span>\n            <span class=\"n\">json</span><span class=\"o\">=</span><span class=\"p\">{</span><span class=\"s2\">\"file_ids\"</span><span class=\"p\">:</span> <span class=\"n\">file_ids</span><span class=\"p\">},</span>\n            <span class=\"n\">headers</span><span class=\"o\">=</span><span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">_headers</span><span class=\"p\">,</span>\n            <span class=\"n\">timeout</span><span class=\"o\">=</span><span class=\"mi\">120</span><span class=\"p\">,</span>\n        <span class=\"p\">)</span>\n        <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">raise_for_status</span><span class=\"p\">()</span>\n        <span class=\"k\">return</span> <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">json</span><span class=\"p\">()</span></div>\n\n\n<div class=\"viewcode-block\" id=\"DocWorm.detach_document\">\n<a class=\"viewcode-back\" href=\"../../../client/#docworm.client.DocWorm.detach_document\">[docs]</a>\n    <span class=\"k\">def</span><span class=\"w\"> </span><span class=\"nf\">detach_document</span><span class=\"p\">(</span><span class=\"bp\">self</span><span class=\"p\">,</span> <span class=\"n\">chat_id</span><span class=\"p\">:</span> <span class=\"nb\">str</span><span class=\"p\">,</span> <span class=\"n\">file_id</span><span class=\"p\">:</span> <span class=\"nb\">str</span><span class=\"p\">)</span> <span class=\"o\">-&gt;</span> <span class=\"nb\">dict</span><span class=\"p\">:</span>\n<span class=\"w\">        </span><span class=\"sd\">\"\"\"Remove a document attachment from a chat.\"\"\"</span>\n        <span class=\"n\">resp</span> <span class=\"o\">=</span> <span class=\"n\">httpx</span><span class=\"o\">.</span><span class=\"n\">post</span><span class=\"p\">(</span>\n            <span class=\"sa\">f</span><span class=\"s2\">\"</span><span class=\"si\">{</span><span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">base_url</span><span class=\"si\">}</span><span class=\"s2\">/v1/chats/</span><span class=\"si\">{</span><span class=\"n\">quote</span><span class=\"p\">(</span><span class=\"n\">chat_id</span><span class=\"p\">)</span><span class=\"si\">}</span><span class=\"s2\">/detach\"</span><span class=\"p\">,</span>\n            <span class=\"n\">json</span><span class=\"o\">=</span><span class=\"p\">{</span><span class=\"s2\">\"file_id\"</span><span class=\"p\">:</span> <span class=\"n\">file_id</span><span class=\"p\">},</span>\n            <span class=\"n\">headers</span><span class=\"o\">=</span><span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">_headers</span><span class=\"p\">,</span>\n            <span class=\"n\">timeout</span><span class=\"o\">=</span><span class=\"mi\">30</span><span class=\"p\">,</span>\n        <span class=\"p\">)</span>\n        <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">raise_for_status</span><span class=\"p\">()</span>\n        <span class=\"k\">return</span> <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">json</span><span class=\"p\">()</span></div>\n\n\n<div class=\"viewcode-block\" id=\"DocWorm.register_chat_file\">\n<a class=\"viewcode-back\" href=\"../../../client/#docworm.client.DocWorm.register_chat_file\">[docs]</a>\n    <span class=\"k\">def</span><span class=\"w\"> </span><span class=\"nf\">register_chat_file</span><span class=\"p\">(</span>\n        <span class=\"bp\">self</span><span class=\"p\">,</span>\n        <span class=\"n\">name</span><span class=\"p\">:</span> <span class=\"nb\">str</span><span class=\"p\">,</span>\n        <span class=\"n\">gcs_path</span><span class=\"p\">:</span> <span class=\"nb\">str</span><span class=\"p\">,</span>\n        <span class=\"n\">chat_id</span><span class=\"p\">:</span> <span class=\"nb\">str</span><span class=\"p\">,</span>\n        <span class=\"n\">file_id</span><span class=\"p\">:</span> <span class=\"nb\">str</span><span class=\"p\">,</span>\n        <span class=\"n\">title</span><span class=\"p\">:</span> <span class=\"n\">Optional</span><span class=\"p\">[</span><span class=\"nb\">str</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"kc\">None</span><span class=\"p\">,</span>\n        <span class=\"n\">project_id</span><span class=\"p\">:</span> <span class=\"n\">Optional</span><span class=\"p\">[</span><span class=\"nb\">str</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"kc\">None</span><span class=\"p\">,</span>\n        <span class=\"n\">size</span><span class=\"p\">:</span> <span class=\"nb\">int</span> <span class=\"o\">=</span> <span class=\"mi\">0</span><span class=\"p\">,</span>\n        <span class=\"n\">mime_type</span><span class=\"p\">:</span> <span class=\"nb\">str</span> <span class=\"o\">=</span> <span class=\"s2\">\"\"</span><span class=\"p\">,</span>\n    <span class=\"p\">)</span> <span class=\"o\">-&gt;</span> <span class=\"nb\">dict</span><span class=\"p\">:</span>\n<span class=\"w\">        </span><span class=\"sd\">\"\"\"</span>\n<span class=\"sd\">        Register a chat-uploaded file and enqueue indexing in the background.</span>\n\n<span class=\"sd\">        ``file_id`` is required and always sent as ``fileId``.</span>\n\n<span class=\"sd\">        Returns:</span>\n<span class=\"sd\">            Dict with fileId and id.</span>\n<span class=\"sd\">        \"\"\"</span>\n        <span class=\"n\">body</span><span class=\"p\">:</span> <span class=\"nb\">dict</span> <span class=\"o\">=</span> <span class=\"p\">{</span>\n            <span class=\"s2\">\"name\"</span><span class=\"p\">:</span> <span class=\"n\">name</span><span class=\"p\">,</span>\n            <span class=\"s2\">\"gcsPath\"</span><span class=\"p\">:</span> <span class=\"n\">gcs_path</span><span class=\"p\">,</span>\n            <span class=\"s2\">\"chatId\"</span><span class=\"p\">:</span> <span class=\"n\">chat_id</span><span class=\"p\">,</span>\n            <span 