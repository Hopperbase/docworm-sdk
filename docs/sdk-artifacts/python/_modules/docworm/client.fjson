 class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"n\">content</span>\n        <span class=\"k\">if</span> <span class=\"ow\">not</span> <span class=\"n\">body</span><span class=\"p\">:</span>\n            <span class=\"k\">raise</span> <span class=\"ne\">ValueError</span><span class=\"p\">(</span><span class=\"s2\">\"edit_message requires message or content\"</span><span class=\"p\">)</span>\n        <span class=\"n\">resp</span> <span class=\"o\">=</span> <span class=\"n\">httpx</span><span class=\"o\">.</span><span class=\"n\">put</span><span class=\"p\">(</span>\n            <span class=\"sa\">f</span><span class=\"s2\">\"</span><span class=\"si\">{</span><span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">base_url</span><span class=\"si\">}</span><span class=\"s2\">/v1/chats/</span><span class=\"si\">{</span><span class=\"n\">quote</span><span class=\"p\">(</span><span class=\"n\">chat_id</span><span class=\"p\">)</span><span class=\"si\">}</span><span class=\"s2\">/messages/</span><span class=\"si\">{</span><span class=\"n\">quote</span><span class=\"p\">(</span><span class=\"n\">msg_id</span><span class=\"p\">)</span><span class=\"si\">}</span><span class=\"s2\">\"</span><span class=\"p\">,</span>\n            <span class=\"n\">json</span><span class=\"o\">=</span><span class=\"n\">body</span><span class=\"p\">,</span>\n            <span class=\"n\">headers</span><span class=\"o\">=</span><span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">_headers</span><span class=\"p\">,</span>\n            <span class=\"n\">timeout</span><span class=\"o\">=</span><span class=\"mi\">30</span><span class=\"p\">,</span>\n        <span class=\"p\">)</span>\n        <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">raise_for_status</span><span class=\"p\">()</span>\n        <span class=\"k\">return</span> <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">json</span><span class