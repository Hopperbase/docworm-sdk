v1/chats/</span><span class=\"si\">{</span><span class=\"n\">quote</span><span class=\"p\">(</span><span class=\"n\">chat_id</span><span class=\"p\">)</span><span class=\"si\">}</span><span class=\"s2\">/messages/</span><span class=\"si\">{</span><span class=\"n\">quote</span><span class=\"p\">(</span><span class=\"n\">msg_id</span><span class=\"p\">)</span><span class=\"si\">}</span><span class=\"s2\">/diagnose\"</span><span class=\"p\">,</span>\n            <span class=\"n\">headers</span><span class=\"o\">=</span><span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">_headers</span><span class=\"p\">,</span>\n            <span class=\"n\">timeout</span><span class=\"o\">=</span><span class=\"mi\">30</span><span class=\"p\">,</span>\n        <span class=\"p\">)</span>\n        <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">raise_for_status</span><span class=\"p\">()</span>\n        <span class=\"k\">return</span> <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">json</span><span class=\"p\">()</span></div>\n\n\n<div class=\"viewcode-block\" id=\"DocWorm.consolidate_memories\">\n<a class=\"viewcode-back\" href=\"../../../client/#docworm.client.DocWorm.consolidate_memories\">[docs]</a>\n    <span class=\"k\">def</span><span class=\"w\"> </span><span class=\"nf\">consolidate_memories</span><span class=\"p\">(</span><span class=\"bp\">self</span><span class=\"p\">,</span> <span class=\"n\">chat_id</span><span class=\"p\">:</span> <span class=\"nb\">str</span><span class=\"p\">,</span> <span class=\"n\">llm</span><span class=\"p\">:</span> <span class=\"nb\">bool</span> <span class=\"o\">=</span> <span class=\"kc\">False</span><span class=\"p\">)</span> <span class=\"o\">-&gt;</span> <span class=\"nb\">dict</span><span class=\"p\">:</span>\n<span class=\"w\">        </span><span class=\"sd\">\"\"\"Consolidate unconsolidated session memories for a chat.\"\"\"</span>\n        <span class=\"n\">resp</span> <span class=\"o\">=</span> <span class=\"n\">httpx</span><span class=\"o\">.</span><span class=\"n\">post</span><span class=\"p\">(</span>\n            <span class=\"sa\">f</span><span class=\"s2\">\"</span><span class=\"si\">{</span><span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">base_url</span><span class=\"si\">}</span><span class=\"s2\">/v1/chats/</span><span class=\"si\">{</span><span class=\"n\">quote</span><span class=\"p\">(</span><span class=\"n\">chat_id</span><span class=\"p\">)</span><span class=\"si\">}</span><span class=\"s2\">/consolidate\"</span><span class=\"p\">,</span>\n            <span class=\"n\">json</span><span class=\"o\">=</span><span class=\"p\">{</span><span class=\"s2\">\"llm\"</span><span class=\"p\">:</span> <span class=\"n\">llm</span><span class=\"p\">},</span>\n            <span class=\"n\">headers</span><span class=\"o\">=</span><span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">_headers</span><span class=\"p\">,</span>\n            <span class=\"n\">timeout</span><span class=\"o\">=</span><span class=\"mi\">120</span><span class=\"p\">,</span>\n        <span class=\"p\">)</span>\n        <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">raise_for_status</span><span class=\"p\">()</span>\n        <span class=\"k\">return</span> <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">json</span><span class=\"p\">()</span></div>\n\n\n<div class=\"viewcode-block\" id=\"DocWorm.download_output\">\n<a class=\"viewcode-back\" href=\"../../../client/#docworm.client.DocWorm.download_output\">[docs]</a>\n    <span class=\"k\">def</span><span class=\"w\"> </span><span class=\"nf\">download_output</span><span class=\"p\">(</span><span class=\"bp\">self</span><span class=\"p\">,</span> <span class=\"n\">chat_id</span><span class=\"p\">:</span> <span class=\"nb\">str</span><span class=\"p\">,</span> <span class=\"n\">session_id</span><span class=\"p\">:</span> <span class=\"nb\">str</span><span class=\"p\">,</span> <span class=\"n\">filename</span><span class=\"p\">:</span> <span class=\"nb\">str</span><span class=\"p\">)</span> <span class=\"o\">-&gt;</span> <span class=\"nb\">bytes</span><span class=\"p\">:</span>\n<span class=\"w\">        </span><span class=\"sd\">\"\"\"Download an archived structured-output file.\"\"\"</span>\n        <span class=\"n\">resp</span> <span class=\"o\">=</span> <span class=\"n\">httpx</span><span class=\"o\">.</span><span class=\"n\">get</span><span class=\"p\">(</span>\n            <span class=\"sa\">f</span><span class=\"s2\">\"</span><span class=\"si\">{</span><span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">base_url</span><span class=\"si\">}</span><span class=\"s2\">/v1/chats/</span><span class=\"si\">{</span><span class=\"n\">quote</span><span class=\"p\">(</span><span class=\"n\">chat_id</span><span class=\"p\">)</span><span class=\"si\">}</span><span class=\"s2\">/outputs/\"</span>\n            <span class=\"sa\">f</span><span class=\"s2\">\"</span><span class=\"si\">{</span><span class=\"n\">quote</span><span class=\"p\">(</span><span class=\"n\">session_id</span><span class=\"p\">)</span><span class=\"si\">}</span><span class=\"s2\">/</span><span class=\"si\">{</span><span class=\"n\">quote</span><span class=\"p\">(</span><span class=\"n\">filename</span><span class=\"p\">)</span><span class=\"si\">}</span><span class=\"s2\">\"</span><span class=\"p\">,</span>\n            <span class=\"n\">headers</span><span class=\"o\">=</span><span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">_headers</span><span class=\"p\">,</span>\n            <span class=\"n\">timeout</span><span class=\"o\">=</span><span class=\"mi\">120</span><span class=\"p\">,</span>\n        <span class=\"p\">)</span>\n        <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">raise_for_status</span><span class=\"p\">()</span>\n        <span class=\"k\">return</span> <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">content</span></div>\n\n\n<div class=\"viewcode-block\" id=\"DocWorm.generate_title\">\n<a class=\"viewcode-back\" href=\"../../../client/#docworm.client.DocWorm.generate_title\">[docs]</a>\n    <span class=\"k\">def</span><span class=\"w\"> </span><span class=\"nf\">generate_title</span><span class=\"p\">(</span><span class=\"bp\">self</span><span class=\"p\">,</span> <span class=\"n\">prompt</span><span class=\"p\">:</span> <span class=\"nb\">str</span><span class=\"p\">)</span> <span class=\"o\">-&gt;</span> <span class=\"nb\">str</span><span class=\"p\">:</span>\n<span class=\"w\">        </span><span class=\"sd\">\"\"\"Generate a short title from a user prompt.\"\"\"</span>\n        <span class=\"n\">resp</span> <span class=\"o\">=</span> <span class=\"n\">httpx</span><span class=\"o\">.</span><span class=\"n\">post</span><span class=\"p\">(</span>\n            <span class=\"sa\">f</span><span class=\"s2\">\"</span><span class=\"si\">{</span><span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">base_url</span><span class=\"si\">}</span><span class=\"s2\">/v1/title\"</span><span class=\"p\">,</span>\n            <span class=\"n\">json</span><span class=\"o\">=</span><span class=\"p\">{</span><span class=\"s2\">\"prompt\"</span><span class=\"p\">:</span> <span class=\"n\">prompt</span><span class=\"p\">},</span>\n            <span class=\"n\">headers</span><span class=\"o\">=</span><span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">_headers</span><span class=\"p\">,</span>\n            <span class=\"n\">timeout</span><span class=\"o\">=</span><span class=\"mi\">60</span><span class=\"p\">,</span>\n        <span class=\"p\">)</span>\n        <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">raise_for_status</span><span class=\"p\">()</span>\n        <span class=\"k\">return</span> <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">json</span><span class=\"p\">()</span><span class=\"o\">.</span><span class=\"n\">get</span><span class=\"p\">(</span><span class=\"s2\">\"title\"</span><span class=\"p\">,</span> <span class=\"s2\">\"\"</span><span class=\"p\">)</span></div>\n\n\n    <span class=\"c1\"># \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550</span>\n    <span class=\"c1\"># CHAT (WebSocket + SSE streaming)</span>\n    <span class=\"c1\"># \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550</span>\n\n    <span class=\"nd\">@staticmethod</span>\n    <span class=\"k\">def</span><span class=\"w\"> </span><span class=\"nf\">_normalize_ws_data</span><span class=\"p\">(</span><span class=\"n\">data</span><span class=\"p\">:</span> <span class=\"n\">Any</span><span class=\"p\">)</span> <span class=\"o\">-&gt;</span> <span class=\"nb\">dict</span><span class=\"p\">:</span>\n        <span class=\"k\">return</span> <span class=\"n\">_normalize_chat_data</span><span class=\"p\">(</span><span class=\"n\">data</span><span class=\"p\">)</span>\n\n    <span class=\"nd\">@classmethod</span>\n    <span class=\"k\">def</span><span class=\"w\"> </span><span class=\"nf\">_map_ws_event</span><span class=\"p\">(</span><span class=\"bp\">cls</span><span class=\"p\">,</span> <span class=\"n\">event</span><span class=\"p\">:</span> <span class=\"nb\">str</span><span class=\"p\">,</span> <span class=\"n\">data</span><span class=\"p\">:</span> <span class=\"n\">Any</span><span class=\"p\">)</span> <span class=\"o\">-&gt;</span> <span class=\"n\">Optional</span><span class=\"p\">[</span><span class=\"n\">ChatEvent</span><span class=\"p\">]:</span>\n<span class=\"w\">        </span><span class=\"sd\">\"\"\"Map a backend WS event to a ChatEvent. Returns None to skip.\"\"\"</span>\n        <span class=\"k\">return</span> <span class=\"n\">_map_chat_event</span><span class=\"p\">(</span><span class=\"n\">event</span><span class=\"p\">,</span> <span class=\"n\">data</span><span class=\"p\">)</span>\n\n    <span class=\"k\">async</span> <span class=\"k\">def</span><span class=\"w\"> </span><span class=\"nf\">_ws_stream</span><span class=\"p\">(</span>\n        <span class=\"bp\">self</span><span class=\"p\">,</span> <span class=\"n\">chat_id</span><span class=\"p\">:</span> <span class=\"nb\">str</span><span class=\"p\">,</span> <span class=\"n\">request_frame</span><span class=\"p\">:</span> <span class=\"nb\">dict</span>\n    <span class=\"p\">)</span> <span class=\"o\">-&gt;</span> <span class=\"n\">AsyncGenerator</span><span class=\"p\">[</span><span class=\"n\">ChatEvent</span><span class=\"p\">,</span> <span class=\"kc\">None</span><span class=\"p\">]:</span>\n        <span class=\"k\">try</span><span class=\"p\">:</span>\n            <span class=\"kn\">import</span><span class=\"w\"> </span><span class=\"nn\">websockets</span>\n        <span class=\"k\">except</span> <span class=\"ne\">ImportError</span> <span class=\"k\">as</span> <span class=\"n\">e</span><span class=\"p\">:</span>\n            <span class=\"k\">raise</span> <span class=\"ne\">RuntimeError</span><span class=\"p\">(</span>\n                <span class=\"s2\">\"WebSocket chat requires the 'websockets' package: pip install websockets\"</span>\n            <span class=\"p\">)</span> <span class=\"kn\">from</span><span class=\"w\"> </span><span class=\"nn\">e</span>\n\n        <span class=\"n\">url</span> <span class=\"o\">=</span> <span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">_ws_url</span><span class=\"p\">(</span><span class=\"sa\">f</span><span class=\"s2\">\"/v1/chats/</span><span class=\"si\">{</span><span class=\"n\">quote</span><span class=\"p\">(</span><span class=\"n\">chat_id</span><span class=\"p\">)</span><span class=\"si\">}</span><span class=\"s2\">/chat\"</span><span class=\"p\">)</span>\n        <span class=\"k\">async</span> <span class=\"k\">with</span> <span class=\"n\">websockets</span><span class=\"o\">.</span><span class=\"n\">connect</span><span class=\"p\">(</span><span class=\"n\">url</span><span class=\"p\">,</span> <span class=\"n\">max_size</span><span class=\"o\">=</span><span class=\"mi\">16</span> <span class=\"o\">*</span> <span class=\"mi\">1024</span> <span class=\"o\">*</span> <span class=\"mi\">1024</span><span class=\"p\">)</span> <span class=\"k\">as</span> <span class=\"n\">ws</span><span class=\"p\">:</span>\n            <span class=\"k\">await</span> <span class=\"n\">ws</span><span class=\"o\">.</span><span class=\"n\">send</span><span class=\"p\">(</span><span class=\"n\">json</span><span class=\"o\">.</span><span class=\"n\">dumps</span><span class=\"p\">(</span><span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">_ws_auth_frame</span><span class=\"p\">()))</span>\n            <span class=\"k\">try</span><span class=\"p\">:</span>\n                <span class=\"n\">raw</span> <span class=\"o\">=</span> <span class=\"k\">await</span> <span class=\"n\">ws</span><span class=\"o\">.</span><span class=\"n\">recv</span><span class=\"p\">()</span>\n            <span class=\"k\">except</span> <span class=\"ne\">Exception</span> <span class=\"k\">as</span> <span class=\"n\">e</span><span class=\"p\">:</span>\n                <span class=\"k\">yield</span> <span class=\"n\">ChatEvent</span><span class=\"p\">(</span><span class=\"nb\">type</span><span class=\"o\">=</span><span class=\"s2\">\"error\"</span><span class=\"p\">,</span> <span class=\"n\">error</span><span class=\"o\">=</span><span class=\"sa\">f</span><span class=\"s2\">\"WS auth failed: </span><span class=\"si\">{</span><span class=\"n\">e</span><span class=\"si\">}</span><span class=\"s2\">\"</span><span class=\"p\">)</span>\n                <span class=\"k\">return</span>\n            <span class=\"k\">try</span><span class=\"p\">:</span>\n                <span class=\"n\">auth_resp</span> <span class=\"o\">=</span> <span class=\"n\">json</span><span class=\"o\">.</span><span class=\"n\">loads</span><span class=\"p\">(</span><span class=\"n\">raw</span><span class=\"p\">)</span>\n            <span class=\"k\">except</span> <span class=\"n\">json</span><span class=\"o\">.</span><span class=\"n\">JSONDecodeError</span><span class=\"p\">:</span>\n                <span class=\"k\">yield</span> <span class=\"n\">ChatEvent</span><span class=\"p\">(</span><span class=\"nb\">type</span><span class=\"o\">=</span><span class=\"s2\">\"error\"</span><span class=\"p\">,</span> <span class=\"n\">error</span><span class=\"o\">=</span><span class=\"s2\">\"WS auth: invalid response\"</span><span class=\"p\">)</span>\n                <span class=\"k\">return</span>\n            <span class=\"k\">if</span> <span class=\"n\">auth_resp</span><span class=\"o\">.</span><span class=\"n\">get</span><span class=\"p\">(</span><span class=\"s2\">\"type\"</span><span class=\"p\">)</span> <span class=\"o\">!=</span> <span class=\"s2\">\"auth_ok\"</span><span class=\"p\">:</span>\n                <span class=\"k\">yield</span> <span class=\"n\">ChatEvent</span><span class=\"p\">(</span>\n                    <span class=\"nb\">type</span><span class=\"o\">=</span><span class=\"s2\">\"error\"</span><span class=\"p\">,</span>\n                    <span class=\"n\">error</span><span class=\"o\">=</span><span class=\"nb\">str</span><span class=\"p\">(</span><span class=\"n\">auth_resp</span><span class=\"o\">.</span><span class=\"n\">get</span><span class=\"p\">(</span><span class=\"s2\">\"error\"</span><span class=\"p\">,</span> <span class=\"n\">auth_resp</span><span class=\"p\">)),</span>\n                <span class=\"p\">)</span>\n                <span class=\"k\">return</span>\n\n            <span class=\"k\">await</span> <span class=\"n\">ws</span><span class=\"o\">.</span><span class=\"n\">send</span><span class=\"p\">(</span><span class=\"n\">json</span><span class=\"o\">.</span><span class=\"n\">dumps</span><span class=\"p\">(</span><span class=\"n\">request_frame</span><span class=\"p\">))</span>\n            <span class=\"k\">async</span> <span class=\"k\">for</span> <span class=\"n\">raw_msg</span> <span class=\"ow\">in</span> <span class=\"n\">ws</span><span class=\"p\">:</span>\n                <span class=\"k\">try</span><span class=\"p\">:</span>\n                    <span class=\"n\">msg</span> <span class=\"o\">=</span> <span class=\"n\">json</span><span class=\"o\">.</span><span class=\"n\">loads</span><span class=\"p\">(</span><span class=\"n\">raw_msg</span><span class=\"p\">)</span>\n                <span class=\"k\">except</span> <span class=\"n\">json</span><span class=\"o\">.</span><span class=\"n\">JSONDecodeError</span><span class=\"p\">:</span>\n                    <span class=\"k\">continue</span>\n                <span class=\"n\">event</span> <span class=\"o\">=</span> <span class=\"n\">msg</span><span class=\"o\">.</span><span class=\"n\">get</span><span class=\"p\">(</span><span class=\"s2\">\"event\"</span><span class=\"p\">,</span> <span class=\"s2\">\"\"</span><span class=\"p\">)</span>\n                <span class=\"n\">evt</span> <span class=\"o\">=</span> <span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">_map_ws_event</span><span class=\"p\">(</span><span class=\"n\">event</span><span class=\"p\">,</span> <span class=\"n\">msg</span><span class=\"o\">.</span><span class=\"n\">get</span><span class=\"p\">(</span><span class=\"s2\">\"data\"</span><span class=\"p\">,</span> <span class=\"p\">{}))</span>\n                <span class=\"k\">if</span> <span class=\"n\">evt</span> <span class=\"ow\">is</span> <span class=\"kc\">None</span><span class=\"p\">:</span>\n                    <span class=\"k\">continue</span>\n                <span class=\"k\">yield</span> <span class=\"n\">evt</span>\n                <span class=\"k\">if</span> <span class=\"n\">evt</span><span class=\"o\">.</span><span class=\"n\">type</span> <span class=\"ow\">in</span> <span class=\"p\">(</span><span class=\"s2\">\"done\"</span><span class=\"p\">,</span> <span class=\"s2\">\"error\"</span><span class=\"p\">):</span>\n                    <span class=\"k\">return</span>\n\n<div class=\"viewcode-block\" id=\"DocWorm.chat_stream\">\n<a class=\"viewcode-back\" href=\"../../../client/#docworm.client.DocWorm.chat_stream\">[docs]</a>\n    <span class=\"k\">def</span><span class=\"w\"> </span><span class=\"nf\">chat_stream</span><span class=\"p\">(</span>\n        <span class=\"bp\">self</span><span class=\"p\">,</span>\n        <span class=\"n\">chat_id</span><span class=\"p\">:</span> <span class=\"nb\">str</span><span class=\"p\">,</span>\n        <span class=\"n\">message</span><span class=\"p\">:</span> <span class=\"nb\">str</span><span class=\"p\">,</span>\n        <span class=\"n\">attached_docs</span><span class=\"p\">:</span> <span class=\"n\">Optional</span><span class=\"p\">[</span><span class=\"nb\">list</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"kc\">None</span><span class=\"p\">,</span>\n        <span class=\"n\">orchestration</span><span class=\"p\">:</span> <span class=\"nb\">str</span> <span class=\"o\">=</span> <span class=\"s2\">\"auto\"</span><span class=\"p\">,</span>\n        <span class=\"n\">parent_msg_id</span><span class=\"p\">:</span> <span class=\"nb\">str</span> <span class=\"o\">=</span> <span class=\"s2\">\"\"</span><span class=\"p\">,</span>\n        <span class=\"n\">retry_msg_id</span><span class=\"p\">:</span> <span class=\"nb\">str</span> <span class=\"o\">=</span> <span class=\"s2\">\"\"</span><span class=\"p\">,</span>\n        <span class=\"n\">base_msg_id</span><span class=\"p\">:</span> <span class=\"nb\">str</span> <span class=\"o\">=</span> <span class=\"s2\">\"\"</span><span class=\"p\">,</span>\n    <span class=\"p\">)</span> <span class=\"o\">-&gt;</span> <span class=\"n\">AsyncGenerator</span><span class=\"p\">[</span><span class=\"n\">ChatEvent</span><span class=\"p\">,</span> <span class=\"kc\">None</span><span class=\"p\">]:</span>\n<span class=\"w\">        </span><span class=\"sd\">\"\"\"</span>\n<span class=\"sd\">        Stream a chat turn over WebSocket.</span>\n\n<span class=\"sd\">        Args:</span>\n<span class=\"sd\">            chat_id: Chat identifier.</span>\n<span class=\"sd\">            message: User message (empty for pure retries driven by ids).</span>\n<span class=\"sd\">            attached_docs: [{\"id\": file_id, \"name\": ...}] \u2014 defaults to the</span>\n<span class=\"sd\">                chat's attachments server-side when omitted.</span>\n<span class=\"sd\">            orchestration: \"auto\" (strategy-based) or \"direct\".</span>\n<span class=\"sd\">            parent_msg_id, retry_msg_id, base_msg_id: retry/edit context \u2014</span>\n<span class=\"sd\">                call retry_chat_message() first for retries.</span>\n\n<span class=\"sd\">        Yields:</span>\n<span class=\"sd\">            ChatEvent objects (thinking \u2192 answer \u2192 citation* \u2192 done/error).</span>\n<span class=\"sd\">            Consume with ``async for``.</span>\n<span class=\"sd\">        \"\"\"</span>\n        <span class=\"n\">frame</span><span class=\"p\">:</span> <span class=\"nb\">dict</span> <span class=\"o\">=</span> <span class=\"p\">{</span>\n            <span class=\"s2\">\"type\"</span><span class=\"p\">:</span> <span class=\"s2\">\"chat\"</span><span class=\"p\">,</span>\n            <span class=\"s2\">\"message\"</span><span class=\"p\">:</span> <span class=\"n\">message</span><span class=\"p\">,</span>\n            <span class=\"s2\">\"orchestration\"</span><span class=\"p\">:</span> <span class=\"n\">orchestration</span><span class=\"p\">,</span>\n        <span class=\"p\">}</span>\n        <span class=\"k\">if</span> <span class=\"n\">attached_docs</span><span class=\"p\">:</span>\n            <span class=\"n\">frame</span><span class=\"p\">[</span><span class=\"s2\">\"attached_docs\"</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"n\">attached_docs</span>\n        <span class=\"k\">if</span> <span class=\"n\">parent_msg_id</span><span class=\"p\">:</span>\n            <span class=\"n\">frame</span><span class=\"p\">[</span><span class=\"s2\">\"parent_msg_id\"</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"n\">parent_msg_id</span>\n        <span class=\"k\">if</span> <span class=\"n\">retry_msg_id</span><span class=\"p\">:</span>\n            <span class=\"n\">frame</span><span class=\"p\">[</span><span class=\"s2\">\"retry_msg_id\"</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"n\">retry_msg_id</span>\n        <span class=\"k\">if</span> <span class=\"n\">base_msg_id</span><span class=\"p\">:</span>\n            <span class=\"n\">frame</span><span class=\"p\">[</span><span class=\"s2\">\"base_msg_id\"</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"n\">base_msg_id</span>\n        <span class=\"k\">return</span> <span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">_ws_stream</span><span class=\"p\">(</span><span class=\"n\">chat_id</span><span class=\"p\">,</span> <span class=\"n\">frame</span><span class=\"p\">)</span></div>\n\n\n<div class=\"viewcode-block\" id=\"DocWorm.chat_reconnect\">\n<a class=\"viewcode-back\" href=\"../../../client/#docworm.client.DocWorm.chat_reconnect\">[docs]</a>\n    <span class=\"k\">def</span><span class=\"w\"> </span><span class=\"nf\">chat_reconnect</span><span class=\"p\">(</span>\n        <span class=\"bp\">self</span><span class=\"p\">,</span> <span class=\"n\">chat_id</span><span class=\"p\">:</span> <span class=\"nb\">str</span><span class=\"p\">,</span> <span class=\"n\">msg_id</span><span class=\"p\">:</span> <span class=\"nb\">str</span><span class=\"p\">,</span> <span class=\"n\">last_seq</span><span class=\"p\">:</span> <span class=\"nb\">int</span> <span class=\"o\">=</span> <span class=\"o\">-</span><span class=\"mi\">1</span>\n    <span class=\"p\">)</span> <span class=\"o\">-&gt;</span> <span class=\"n\">AsyncGenerator</span><span class=\"p\">[</span><span class=\"n\">ChatEvent</span><span class=\"p\">,</span> <span class=\"kc\">None</span><span class=\"p\">]:</span>\n<span class=\"w\">        </span><span class=\"sd\">\"\"\"</span>\n<span class=\"sd\">        Replay missed events of a previously-started stream.</span>\n<span class=\"sd\">        \"\"\"</span>\n        <span class=\"k\">return</span> <span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">_ws_stream</span><span class=\"p\">(</span>\n            <span class=\"n\">chat_id</span><span class=\"p\">,</span>\n            <span class=\"p\">{</span><span class=\"s2\">\"type\"</span><span class=\"p\">:</span> <span class=\"s2\">\"reconnect\"</span><span class=\"p\">,</span> <span class=\"s2\">\"msg_id\"</span><span class=\"p\">:</span> <span class=\"n\">msg_id</span><span class=\"p\">,</span> <span class=\"s2\">\"last_seq\"</span><span class=\"p\">:</span> <span class=\"n\">last_seq</span><span class=\"p\">},</span>\n        <span class=\"p\">)</span></div>\n\n\n<div class=\"viewcode-block\" id=\"DocWorm.chat_interrupt\">\n<a class=\"viewcode-back\" href=\"../../../client/#docworm.client.DocWorm.chat_interrupt\">[docs]</a>\n    <span class=\"k\">def</span><span class=\"w\"> </span><span class=\"nf\">chat_interrupt</span><span class=\"p\">(</span>\n        <span class=\"bp\">self</span><span class=\"p\">,</span>\n        <span class=\"n\">chat_id</span><span class=\"p\">:</span> <span class=\"nb\">str</span><span class=\"p\">,</span>\n        <span class=\"n\">message</span><span class=\"p\">:</span> <span class=\"nb\">str</span><span class=\"p\">,</span>\n        <span class=\"n\">attached_docs</span><span class=\"p\">:</span> <span class=\"n\">Optional</span><span class=\"p\">[</span><span class=\"nb\">list</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"kc\">None</span><span class=\"p\">,</span>\n        <span class=\"n\">orchestration</span><span class=\"p\">:</span> <span class=\"nb\">str</span> <span class=\"o\">=</span> <span class=\"s2\">\"auto\"</span><span class=\"p\">,</span>\n    <span class=\"p\">)</span> <span class=\"o\">-&gt;</span> <span class=\"n\">AsyncGenerator</span><span class=\"p\">[</span><span class=\"n\">ChatEvent</span><span class=\"p\">,</span> <span class=\"kc\">None</span><span class=\"p\">]:</span>\n<span class=\"w\">        </span><span class=\"sd\">\"\"\"</span>\n<span class=\"sd\">        Cancel the current turn and start a new one seeded with a plan.</span>\n<span class=\"sd\">        \"\"\"</span>\n        <span class=\"n\">frame</span><span class=\"p\">:</span> <span class=\"nb\">dict</span> <span class=\"o\">=</span> <span class=\"p\">{</span>\n            <span class=\"s2\">\"type\"</span><span class=\"p\">:</span> <span class=\"s2\">\"chat_interrupt\"</span><span class=\"p\">,</span>\n            <span class=\"s2\">\"message\"</span><span class=\"p\">:</span> <span class=\"n\">message</span><span class=\"p\">,</span>\n            <span class=\"s2\">\"orchestration\"</span><span class=\"p\">:</span> <span class=\"n\">orchestration</span><span class=\"p\">,</span>\n        <span class=\"p\">}</span>\n        <span class=\"k\">if</span> <span class=\"n\">attached_docs</span><span class=\"p\">:</span>\n            <span class=\"n\">frame</span><span class=\"p\">[</span><span class=\"s2\">\"attached_docs\"</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"n\">attached_docs</span>\n        <span class=\"k\">return</span> <span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">_ws_stream</span><span class=\"p\">(</span><span class=\"n\">chat_id</span><span class=\"p\">,</span> <span class=\"n\">frame</span><span class=\"p\">)</span></div>\n\n\n    <span class=\"c1\"># -- SSE streaming (hosted service) ------------------------------</span>\n\n    <span class=\"nd\">@staticmethod</span>\n    <span class=\"k\">def</span><span class=\"w\"> </span><span class=\"nf\">_dispatch_sse_event</span><span class=\"p\">(</span><span class=\"n\">data_lines</span><span class=\"p\">:</span> <span class=\"nb\">list</span><span class=\"p\">[</span><span class=\"nb\">str</span><span class=\"p\">])</span> <span class=\"o\">-&gt;</span> <span class=\"n\">Optional</span><span class=\"p\">[</span><span class=\"n\">ChatEvent</span><span class=\"p\">]:</span>\n<span class=\"w\">        </span><span class=\"sd\">\"\"\"Map one assembled SSE event payload to a ChatEvent.</span>\n\n<span class=\"sd\">        The payload is the JSON object the backend writes on the ``data:``</span>\n<span class=\"sd\">        line: ``{\"event\": name, \"data\": {...}, \"seq\": n}``.</span>\n<span class=\"sd\">        \"\"\"</span>\n        <span class=\"k\">if</span> <span class=\"ow\">not</span> <span class=\"n\">data_lines</span><span class=\"p\">:</span>\n            <span class=\"k\">return</span> <span class=\"kc\">None</span>\n        <span class=\"n\">payload</span> <span class=\"o\">=</span> <span class=\"s2\">\"</span><span class=\"se\">\\n</span><span class=\"s2\">\"</span><span class=\"o\">.</span><span class=\"n\">join</span><span class=\"p\">(</span><span class=\"n\">data_lines</span><span class=\"p\">)</span>\n        <span class=\"k\">try</span><span class=\"p\">:</span>\n            <span class=\"n\">frame</span> <span class=\"o\">=</span> <span class=\"n\">json</span><span class=\"o\">.</span><span class=\"n\">loads</span><span class=\"p\">(</span><span class=\"n\">payload</span><span class=\"p\">)</span>\n        <span class=\"k\">except</span> <span class=\"n\">json</span><span class=\"o\">.</span><span class=\"n\">JSONDecodeError</span><span class=\"p\">:</span>\n            <span class=\"k\">return</span> <span class=\"kc\">None</span>\n        <span class=\"k\">if</span> <span class=\"ow\">not</span> <span class=\"nb\">isinstance</span><span class=\"p\">(</span><span class=\"n\">frame</span><span class=\"p\">,</span> <span class=\"nb\">dict</span><span class=\"p\">):</span>\n            <span class=\"k\">return</span> <span class=\"kc\">None</span>\n        <span class=\"n\">event</span> <span class=\"o\">=</span> <span class=\"n\">frame</span><span class=\"o\">.</span><span class=\"n\">get</span><span class=\"p\">(</span><span class=\"s2\">\"event\"</span><span class=\"p\">,</span> <span class=\"s2\">\"\"</span><span class=\"p\">)</span>\n        <span class=\"k\">return</span> <span class=\"n\">_map_chat_event</span><span class=\"p\">(</span>\n            <span class=\"n\">event</span> <span class=\"k\">if</span> <span class=\"nb\">isinstance</span><span class=\"p\">(</span><span class=\"n\">event</span><span class=\"p\">,</span> <span class=\"nb\">str</span><span class=\"p\">)</span> <span class=\"k\">else</span> <span class=\"s2\">\"\"</span><span class=\"p\">,</span> <span class=\"n\">frame</span><span class=\"o\">.</span><span class=\"n\">get</span><span class=\"p\">(</span><span class=\"s2\">\"data\"</span><span class=\"p\">,</span> <span class=\"p\">{})</span>\n        <span class=\"p\">)</span>\n\n    <span class=\"k\">async</span> <span class=\"k\">def</span><span class=\"w\"> </span><span class=\"nf\">_sse_stream</span><span class=\"p\">(</span>\n        <span class=\"bp\">self</span><span class=\"p\">,</span> <span class=\"n\">chat_id</span><span class=\"p\">:</span> <span class=\"nb\">str</span><span class=\"p\">,</span> <span class=\"n\">request_body</span><span class=\"p\">:</span> <span class=\"nb\">dict</span><span class=\"p\">,</span> <span class=\"n\">timeout</span><span class=\"p\">:</span> <span class=\"nb\">float</span>\n    <span class=\"p\">)</span> <span class=\"o\">-&gt;</span> <span class=\"n\">AsyncGenerator</span><span class=\"p\">[</span><span class=\"n\">ChatEvent</span><span class=\"p\">,</span> <span class=\"kc\">None</span><span class=\"p\">]:</span>\n        <span class=\"n\">url</span> <span class=\"o\">=</span> <span class=\"sa\">f</span><span class=\"s2\">\"</span><span class=\"si\">{</span><span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">base_url</span><span class=\"si\">}</span><span class=\"s2\">/v1/chats/</span><span class=\"si\">{</span><span class=\"n\">quote</span><span class=\"p\">(</span><span class=\"n\">chat_id</span><span class=\"p\">)</span><span class=\"si\">}</span><span class=\"s2\">/stream\"</span>\n        <span class=\"n\">headers</span> <span class=\"o\">=</span> <span class=\"p\">{</span>\n            <span class=\"o\">**</span><span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">_headers</span><span class=\"p\">,</span>\n            <span class=\"s2\">\"Accept\"</span><span class=\"p\">:</span> <span class=\"s2\">\"text/event-stream\"</span><span class=\"p\">,</span>\n            <span class=\"s2\">\"Content-Type\"</span><span class=\"p\">:</span> <span class=\"s2\">\"application/json\"</span><span class=\"p\">,</span>\n        <span class=\"p\">}</span>\n        <span class=\"k\">async</span> <span class=\"k\">with</span> <span class=\"n\">httpx</span><span class=\"o\">.</span><span class=\"n\">AsyncClient</span><span class=\"p\">(</span>\n            <span class=\"n\">timeout</span><span class=\"o\">=</span><span class=\"n\">httpx</span><span class=\"o\">.</span><span class=\"n\">Timeout</span><span class=\"p\">(</span><span class=\"mf\">30.0</span><span class=\"p\">,</span> <span class=\"n\">read</span><span class=\"o\">=</span><span class=\"n\">timeout</span><span class=\"p\">)</span>\n        <span class=\"p\">)</span> <span class=\"k\">as</span> <span class=\"n\">ac</span><span class=\"p\">:</span>\n            <span class=\"k\">async</span> <span class=\"k\">with</span> <span class=\"n\">ac</span><span class=\"o\">.</span><span class=\"n\">stream</span><span class=\"p\">(</span>\n                <span class=\"s2\">\"POST\"</span><span class=\"p\">,</span> <span class=\"n\">url</span><span class=\"p\">,</span> <span class=\"n\">json</span><span class=\"o\">=</span><span class=\"n\">request_body</span><span class=\"p\">,</span> <span class=\"n\">headers</span><span class=\"o\">=</span><span class=\"n\">headers</span>\n            <span class=\"p\">)</span> <span class=\"k\">as</span> <span class=\"n\">resp</span><span class=\"p\">:</span>\n                <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">raise_for_status</span><span class=\"p\">()</span>\n                <span class=\"n\">data_lines</span><span class=\"p\">:</span> <span class=\"nb\">list</span><span class=\"p\">[</span><span class=\"nb\">str</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"p\">[]</span>\n                <span class=\"k\">async</span> <span class=\"k\">for</span> <span class=\"n\">line</span> <span class=\"ow\">in</span> <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">aiter_lines</span><span class=\"p\">():</span>\n                    <span class=\"k\">if</span> <span class=\"n\">line</span> <span class=\"o\">==</span> <span class=\"s2\">\"\"</span><span class=\"p\">:</span>\n                        <span class=\"n\">evt</span> <span class=\"o\">=</span> <span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">_dispatch_sse_event</span><span class=\"p\">(</span><span class=\"n\">data_lines</span><span class=\"p\">)</span>\n                        <span class=\"n\">data_lines</span> <span class=\"o\">=</span> <span class=\"p\">[]</span>\n                        <span class=\"k\">if</span> <span class=\"n\">evt</span> <span class=\"ow\">is</span> <span class=\"kc\">None</span><span class=\"p\">:</span>\n                            <span class=\"k\">continue</span>\n                        <span class=\"k\">yield</span> <span class=\"n\">evt</span>\n                        <span class=\"k\">if</span> <span class=\"n\">evt</span><span class=\"o\">.</span><span class=\"n\">type</span> <span class=\"ow\">in</span> <span class=\"p\">(</span><span class=\"s2\">\"done\"</span><span class=\"p\">,</span> <span class=\"s2\">\"error\"</span><span class=\"p\">):</span>\n                            <span class=\"k\">return</span>\n                        <span class=\"k\">continue</span>\n                    <span class=\"k\">if</span> <span class=\"n\">line</span><span class=\"o\">.</span><span class=\"n\">startswith</span><span class=\"p\">(</span><span class=\"s2\">\":\"</span><span class=\"p\">)</span> <span class=\"ow\">or</span> <span class=\"ow\">not</span> <span class=\"n\">line</span><span class=\"o\">.</span><span class=\"n\">startswith</span><span class=\"p\">(</span><span class=\"s2\">\"data:\"</span><span class=\"p\">):</span>\n                        <span class=\"k\">continue</span>\n                    <span class=\"n\">value</span> <span class=\"o\">=</span> <span class=\"n\">line</span><span class=\"p\">[</span><span class=\"mi\">5</span><span class=\"p\">:]</span>\n                    <span class=\"k\">if</span> <span class=\"n\">value</span><span class=\"o\">.</span><span class=\"n\">startswith</span><span class=\"p\">(</span><span class=\"s2\">\" \"</span><span class=\"p\">):</span>\n                        <span class=\"n\">value</span> <span class=\"o\">=</span> <span class=\"n\">value</span><span class=\"p\">[</span><span class=\"mi\">1</span><span class=\"p\">:]</span>\n                    <span class=\"n\">data_lines</span><span class=\"o\">.</span><span class=\"n\">append</span><span class=\"p\">(</span><span class=\"n\">value</span><span class=\"p\">)</span>\n                <span class=\"c1\"># Flush a final event that arrived without a blank line.</span>\n                <span class=\"n\">evt</span> <span class=\"o\">=</span> <span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">_dispatch_sse_event</span><span class=\"p\">(</span><span class=\"n\">data_lines</span><span class=\"p\">)</span>\n                <span class=\"k\">if</span> <span class=\"n\">evt</span> <span class=\"ow\">is</span> <span class=\"ow\">not</span> <span class=\"kc\">None</span><span class=\"p\">:</span>\n                    <span class=\"k\">yield</span> <span class=\"n\">evt</span>\n\n<div class=\"viewcode-block\" id=\"DocWorm.chat_stream_sse\">\n<a class=\"viewcode-back\" href=\"../../../client/#docworm.client.DocWorm.chat_stream_sse\">[docs]</a>\n    <span class=\"k\">async</span> <span class=\"k\">def</span><span class=\"w\"> </span><span class=\"nf\">chat_stream_sse</span><span class=\"p\">(</span>\n        <span class=\"bp\">self</span><span class=\"p\">,</span>\n        <span class=\"n\">chat_id</span><span class=\"p\">:</span> <span class=\"nb\">str</span><span class=\"p\">,</span>\n        <span class=\"n\">message</span><span class=\"p\">:</span> <span class=\"nb\">str</span><span class=\"p\">,</span>\n        <span class=\"o\">*</span><span class=\"p\">,</span>\n        <span class=\"n\">model</span><span class=\"p\">:</span> <span class=\"n\">Optional</span><span class=\"p\">[</span><span class=\"nb\">str</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"kc\">None</span><span class=\"p\">,</span>\n        <span class=\"n\">orchestration</span><span class=\"p\">:</span> <span class=\"n\">Optional</span><span class=\"p\">[</span><span class=\"nb\">str</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"kc\">None</span><span class=\"p\">,</span>\n        <span class=\"n\">parent_msg_id</span><span class=\"p\">:</span> <span class=\"n\">Optional</span><span class=\"p\">[</span><span class=\"nb\">str</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"kc\">None</span><span class=\"p\">,</span>\n        <span class=\"n\">retry_msg_id</span><span class=\"p\">:</span> <span class=\"n\">Optional</span><span class=\"p\">[</span><span class=\"nb\">str</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"kc\">None</span><span class=\"p\">,</span>\n        <span class=\"n\">base_msg_id</span><span class=\"p\">:</span> <span class=\"n\">Optional</span><span class=\"p\">[</span><span class=\"nb\">str</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"kc\">None</span><span class=\"p\">,</span>\n        <span class=\"n\">timeout</span><span class=\"p\">:</span> <span class=\"nb\">float</span> <span class=\"o\">=</span> <span class=\"mf\">600.0</span><span class=\"p\">,</span>\n    <span class=\"p\">)</span> <span class=\"o\">-&gt;</span> <span class=\"n\">AsyncGenerator</span><span class=\"p\">[</span><span class=\"n\">ChatEvent</span><span class=\"p\">,</span> <span class=\"kc\">None</span><span class=\"p\">]:</span>\n<span class=\"w\">        </span><span class=\"sd\">\"\"\"</span>\n<span class=\"sd\">        Stream a chat turn over SSE (hosted service).</span>\n\n<span class=\"sd\">        Use this instead of :meth:`chat_stream` when a WebSocket upgrade is</span>\n<span class=\"sd\">        unavailable; events and terminal semantics are identical.</span>\n\n<span class=\"sd\">        Args:</span>\n<span class=\"sd\">            chat_id: Chat identifier.</span>\n<span class=\"sd\">            message: User message (empty for pure retries driven by ids).</span>\n<span class=\"sd\">            model: Optional model override forwarded to the backend.</span>\n<span class=\"sd\">            orchestration: \"auto\" (strategy-based) or \"direct\"; server</span>\n<span class=\"sd\">                default when omitted.</span>\n<span class=\"sd\">            parent_msg_id, retry_msg_id, base_msg_id: retry/edit context -</span>\n<span class=\"sd\">                call retry_chat_message() first for retries.</span>\n<span class=\"sd\">            timeout: Read timeout in seconds for the event stream.</span>\n\n<span class=\"sd\">        Yields:</span>\n<span class=\"sd\">            ChatEvent objects (thinking -&gt; answer -&gt; citation* -&gt; done/error).</span>\n<span class=\"sd\">            Consume with ``async for``.</span>\n<span class=\"sd\">        \"\"\"</span>\n        <span class=\"n\">body</span><span class=\"p\">:</span> <span class=\"nb\">dict</span> <span class=\"o\">=</span> <span class=\"p\">{</span><span class=\"s2\">\"type\"</span><span class=\"p\">:</span> <span class=\"s2\">\"chat\"</span><span class=\"p\">,</span> <span class=\"s2\">\"message\"</span><span class=\"p\">:</span> <span class=\"n\">message</span><span class=\"p\">}</span>\n        <span class=\"k\">if</span> <span class=\"n\">model</span><span class=\"p\">:</span>\n            <span class=\"n\">body</span><span class=\"p\">[</span><span class=\"s2\">\"model\"</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"n\">model</span>\n        <span class=\"k\">if</span> <span class=\"n\">orchestration</span><span class=\"p\">:</span>\n            <span class=\"n\">body</span><span class=\"p\">[</span><span class=\"s2\">\"orchestration\"</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"n\">orchestration</span>\n        <span class=\"k\">if</span> <span class=\"n\">parent_msg_id</span><span class=\"p\">:</span>\n            <span class=\"n\">body</span><span class=\"p\">[</span><span class=\"s2\">\"parent_msg_id\"</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"n\">parent_msg_id</span>\n        <span class=\"k\">if</span> <span class=\"n\">retry_msg_id</span><span class=\"p\">:</span>\n            <span class=\"n\">body</span><span class=\"p\">[</span><span class=\"s2\">\"retry_msg_id\"</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"n\">retry_msg_id</span>\n        <span class=\"k\">if</span> <span class=\"n\">base_msg_id</span><span class=\"p\">:</span>\n            <span class=\"n\">body</span><span class=\"p\">[</span><span class=\"s2\">\"base_msg_id\"</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"n\">base_msg_id</span>\n        <span class=\"k\">async</span> <span class=\"k\">for</span> <span class=\"n\">evt</span> <span class=\"ow\">in</span> <span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">_sse_stream</span><span class=\"p\">(</span><span class=\"n\">chat_id</span><span class=\"p\">,</span> <span class=\"n\">body</span><span class=\"p\">,</span> <span class=\"n\">timeout</span><span class=\"p\">):</span>\n            <span class=\"k\">yield</span> <span class=\"n\">evt</span></div>\n\n\n<div class=\"viewcode-block\" id=\"DocWorm.chat_reconnect_sse\">\n<a class=\"viewcode-back\" href=\"../../../client/#docworm.client.DocWorm.chat_reconnect_sse\">[docs]</a>\n    <span class=\"k\">async</span> <span class=\"k\">def</span><span class=\"w\"> </span><span class=\"nf\">chat_reconnect_sse</span><span class=\"p\">(</span>\n        <span class=\"bp\">self</span><span class=\"p\">,</span>\n        <span class=\"n\">chat_id</span><span class=\"p\">:</span> <span class=\"nb\">str</span><span class=\"p\">,</span>\n        <span class=\"n\">msg_id</span><span class=\"p\">:</span> <span class=\"nb\">str</span><span class=\"p\">,</span>\n        <span class=\"n\">last_seq</span><span class=\"p\">:</span> <span class=\"nb\">int</span> <span class=\"o\">=</span> <span class=\"o\">-</span><span class=\"mi\">1</span><span class=\"p\">,</span>\n        <span class=\"o\">*</span><span class=\"p\">,</span>\n        <span class=\"n\">timeout</span><span class=\"p\">:</span> <span class=\"nb\">float</span> <span class=\"o\">=</span> <span class=\"mf\">600.0</span><span class=\"p\">,</span>\n    <span class=\"p\">)</span> <span class=\"o\">-&gt;</span> <span class=\"n\">AsyncGenerator</span><span class=\"p\">[</span><span class=\"n\">ChatEvent</span><span class=\"p\">,</span> <span class=\"kc\">None</span><span class=\"p\">]:</span>\n<span class=\"w\">        </span><span class=\"sd\">\"\"\"</span>\n<span class=\"sd\">        Replay missed events over SSE (hosted service).</span>\n\n<span class=\"sd\">        Mirrors :meth:`chat_reconnect` for deployments without WebSocket</span>\n<span class=\"sd\">        support.</span>\n<span class=\"sd\">        \"\"\"</span>\n        <span class=\"n\">body</span> <span class=\"o\">=</span> <span class=\"p\">{</span><span class=\"s2\">\"type\"</span><span class=\"p\">:</span> <span class=\"s2\">\"reconnect\"</span><span class=\"p\">,</span> <span class=\"s2\">\"msg_id\"</span><span class=\"p\">:</span> <span class=\"n\">msg_id</span><span class=\"p\">,</span> <span class=\"s2\">\"last_seq\"</span><span class=\"p\">:</span> <span class=\"n\">last_seq</span><span class=\"p\">}</span>\n        <span class=\"k\">async</span> <span class=\"k\">for</span> <span class=\"n\">evt</span> <span class=\"ow\">in</span> <span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">_sse_stream</span><span class=\"p\">(</span><span class=\"n\">chat_id</span><span class=\"p\">,</span> <span class=\"n\">body</span><span class=\"p\">,</span> <span class=\"n\">timeout</span><span class=\"p\">):</span>\n            <span class=\"k\">yield</span> <span class=\"n\">evt</span></div>\n\n\n    <span class=\"c1\"># \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550</span>\n    <span class=\"c1\"># REASONING RAG QUERY</span>\n    <span class=\"c1\"># \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550</span>\n\n<div class=\"viewcode-block\" id=\"DocWorm.query\">\n<a class=\"viewcode-back\" href=\"../../../client/#docworm.client.DocWorm.query\">[docs]</a>\n    <span class=\"k\">def</span><span class=\"w\"> </span><span class=\"nf\">query</span><span class=\"p\">(</span>\n        <span class=\"bp\">self</span><span class=\"p\">,</span>\n        <span class=\"n\">query_text</span><span class=\"p\">:</span> <span class=\"nb\">str</span><span class=\"p\">,</span>\n        <span class=\"n\">file_id</span><span class=\"p\">:</span> <span class=\"n\">Optional</span><span class=\"p\">[</span><span class=\"nb\">str</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"kc\">None</span><span class=\"p\">,</span>\n        <span class=\"n\">file_ids</span><span class=\"p\">:</span> <span class=\"n\">Optional</span><span class=\"p\">[</span><span class=\"nb\">list</span><span class=\"p\">[</span><span class=\"nb\">str</span><span class=\"p\">]]</span> <span class=\"o\">=</span> <span class=\"kc\">None</span><span class=\"p\">,</span>\n        <span class=\"n\">include_images</span><span class=\"p\">:</span> <span class=\"nb\">bool</span> <span class=\"o\">=</span> <span class=\"kc\">False</span><span class=\"p\">,</span>\n        <span class=\"n\">inline_images</span><span class=\"p\">:</span> <span class=\"nb\">bool</span> <span class=\"o\">=</span> <span class=\"kc\">False</span><span class=\"p\">,</span>\n        <span class=\"n\">session_id</span><span class=\"p\">:</span> <span class=\"n\">Optional</span><span class=\"p\">[</span><span class=\"nb\">str</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"kc\">None</span><span class=\"p\">,</span>\n        <span class=\"n\">message_id</span><span class=\"p\">:</span> <span class=\"n\">Optional</span><span class=\"p\">[</span><span class=\"nb\">str</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"kc\">None</span><span class=\"p\">,</span>\n        <span class=\"n\">root_collection</span><span class=\"p\">:</span> <span class=\"n\">Optional</span><span class=\"p\">[</span><span class=\"nb\">str</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"kc\">None</span><span class=\"p\">,</span>\n    <span class=\"p\">)</span> <span class=\"o\">-&gt;</span> <span class=\"n\">QueryResponse</span><span class=\"p\">:</span>\n<span class=\"w\">        </span><span class=\"sd\">\"\"\"</span>\n<span class=\"sd\">        Reasoning RAG query over indexed documents.</span>\n\n<span class=\"sd\">        Args:</span>\n<span class=\"sd\">            query_text: The query string.</span>\n<span class=\"sd\">            file_id: Single file ID to query.</span>\n<span class=\"sd\">            file_ids: Multiple file IDs to query.</span>\n<span class=\"sd\">            include_images: Include image URLs in response.</span>\n<span class=\"sd\">            inline_images: Inline base64 images in response.</span>\n<span class=\"sd\">            session_id: Session ID for conversation continuity.</span>\n<span class=\"sd\">            message_id: Message ID the answer attaches to (enables persistence).</span>\n<span class=\"sd\">            root_collection: Firestore root collection override.</span>\n\n<span class=\"sd\">        Returns:</span>\n<span class=\"sd\">            QueryResponse with answer, citations, and reasoning traces.</span>\n<span class=\"sd\">        \"\"\"</span>\n        <span class=\"n\">body</span><span class=\"p\">:</span> <span class=\"nb\">dict</span> <span class=\"o\">=</span> <span class=\"p\">{</span><span class=\"s2\">\"query\"</span><span class=\"p\">:</span> <span class=\"n\">query_text</span><span class=\"p\">}</span>\n        <span class=\"k\">if</span> <span class=\"n\">file_id</span><span class=\"p\">:</span>\n            <span class=\"n\">body</span><span class=\"p\">[</span><span class=\"s2\">\"file_id\"</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"n\">file_id</span>\n        <span class=\"k\">if</span> <span class=\"n\">file_ids</span><span class=\"p\">:</span>\n            <span class=\"n\">body</span><span class=\"p\">[</span><span class=\"s2\">\"file_ids\"</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"n\">file_ids</span>\n        <span class=\"k\">if</span> <span class=\"n\">include_images</span><span class=\"p\">:</span>\n            <span class=\"n\">body</span><span class=\"p\">[</span><span class=\"s2\">\"includeImages\"</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"kc\">True</span>\n        <span class=\"k\">if</span> <span class=\"n\">inline_images</span><span class=\"p\">:</span>\n            <span class=\"n\">body</span><span class=\"p\">[</span><span class=\"s2\">\"inlineImages\"</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"kc\">True</span>\n        <span class=\"k\">if</span> <span class=\"n\">session_id</span><span class=\"p\">:</span>\n            <span class=\"n\">body</span><span class=\"p\">[</span><span class=\"s2\">\"sessionId\"</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"n\">session_id</span>\n        <span class=\"k\">if</span> <span class=\"n\">message_id</span><span class=\"p\">:</span>\n            <span class=\"n\">body</span><span class=\"p\">[</span><span class=\"s2\">\"messageId\"</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"n\">message_id</span>\n        <span class=\"k\">if</span> <span class=\"n\">root_collection</span><span class=\"p\">:</span>\n            <span class=\"n\">body</span><span class=\"p\">[</span><span class=\"s2\">\"rootCollection\"</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"n\">root_collection</span>\n\n        <span class=\"n\">resp</span> <span class=\"o\">=</span> <span class=\"n\">httpx</span><span class=\"o\">.</span><span class=\"n\">post</span><span class=\"p\">(</span>\n            <span class=\"sa\">f</span><span class=\"s2\">\"</span><span class=\"si\">{</span><span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">base_url</span><span class=\"si\">}</span><span class=\"s2\">/v1/query\"</span><span class=\"p\">,</span>\n            <span class=\"n\">json</span><span class=\"o\">=</span><span class=\"n\">body</span><span class=\"p\">,</span>\n            <span class=\"n\">headers</span><span class=\"o\">=</span><span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">_headers</span><span class=\"p\">,</span>\n            <span class=\"n\">timeout</span><span class=\"o\">=</span><span class=\"mi\">300</span><span class=\"p\">,</span>\n        <span class=\"p\">)</span>\n        <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">raise_for_status</span><span class=\"p\">()</span>\n        <span class=\"n\">d</span> <span class=\"o\">=</span> <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">json</span><span class=\"p\">()</span>\n        <span class=\"k\">return</span> <span class=\"n\">QueryResponse</span><span class=\"p\">(</span>\n            <span class=\"n\">answer</span><span class=\"o\">=</span><span class=\"n\">d</span><span class=\"o\">.</span><span class=\"n\">get</span><span class=\"p\">(</span><span class=\"s2\">\"answer\"</span><span class=\"p\">,</span> <span class=\"s2\">\"\"</span><span class=\"p\">),</span>\n            <span class=\"n\">citations</span><span class=\"o\">=</span><span class=\"p\">[</span><span class=\"n\">cited_node_from_dict</span><span class=\"p\">(</span><span class=\"n\">c</span><span class=\"p\">)</span> <span class=\"k\">for</span> <span class=\"n\">c</span> <span class=\"ow\">in</span> <span class=\"n\">d</span><span class=\"o\">.</span><span class=\"n\">get</span><span class=\"p\">(</span><span class=\"s2\">\"citations\"</span><span class=\"p\">,</span> <span class=\"p\">[])],</span>\n            <span class=\"n\">reasoning_traces</span><span class=\"o\">=</span><span class=\"n\">d</span><span class=\"o\">.</span><span class=\"n\">get</span><span class=\"p\">(</span><span class=\"s2\">\"reasoning_traces\"</span><span class=\"p\">,</span> <span class=\"p\">[])</span> <span class=\"ow\">or</span> <span class=\"p\">[],</span>\n            <span class=\"n\">sub_questions</span><span class=\"o\">=</span><span class=\"n\">d</span><span class=\"o\">.</span><span class=\"n\">get</span><span class=\"p\">(</span><span class=\"s2\">\"sub_questions\"</span><span class=\"p\">,</span> <span class=\"p\">[])</span> <span class=\"ow\">or</span> <span class=\"p\">[],</span>\n            <span class=\"n\">nodes_retrieved</span><span class=\"o\">=</span><span class=\"n\">d</span><span class=\"o\">.</span><span class=\"n\">get</span><span class=\"p\">(</span><span class=\"s2\">\"nodes_retrieved\"</span><span class=\"p\">,</span> <span class=\"mi\">0</span><span class=\"p\">)</span> <span class=\"ow\">or</span> <span class=\"mi\">0</span><span class=\"p\">,</span>\n            <span class=\"n\">iterations</span><span class=\"o\">=</span><span class=\"n\">d</span><span class=\"o\">.</span><span class=\"n\">get</span><span class=\"p\">(</span><span class=\"s2\">\"iterations\"</span><span class=\"p\">,</span> <span class=\"mi\">0</span><span class=\"p\">)</span> <span class=\"ow\">or</span> <span class=\"mi\">0</span><span class=\"p\">,</span>\n        <span class=\"p\">)</span></div>\n\n\n<div class=\"viewcode-block\" id=\"DocWorm.cancel_query\">\n<a class=\"viewcode-back\" href=\"../../../client/#docworm.client.DocWorm.cancel_query\">[docs]</a>\n    <span class=\"k\">def</span><span class=\"w\"> </span><span class=\"nf\">cancel_query</span><span class=\"p\">(</span>\n        <span class=\"bp\">self</span><span class=\"p\">,</span>\n        <span class=\"n\">session_id</span><span class=\"p\">:</span> <span class=\"nb\">str</span><span class=\"p\">,</span>\n        <span class=\"n\">message_id</span><span class=\"p\">:</span> <span class=\"nb\">str</span><span class=\"p\">,</span>\n        <span class=\"n\">root_collection</span><span class=\"p\">:</span> <span class=\"n\">Optional</span><span class=\"p\">[</span><span class=\"nb\">str</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"kc\">None</span><span class=\"p\">,</span>\n    <span class=\"p\">)</span> <span class=\"o\">-&gt;</span> <span class=\"nb\">dict</span><span class=\"p\">:</span>\n<span class=\"w\">        </span><span class=\"sd\">\"\"\"</span>\n<span class=\"sd\">        Cancel an active reasoning query.</span>\n<span class=\"sd\">        \"\"\"</span>\n        <span class=\"n\">body</span><span class=\"p\">:</span> <span class=\"nb\">dict</span> <span class=\"o\">=</span> <span class=\"p\">{</span><span class=\"s2\">\"session_id\"</span><span class=\"p\">:</span> <span class=\"n\">session_id</span><span class=\"p\">,</span> <span class=\"s2\">\"message_id\"</span><span class=\"p\">:</span> <span class=\"n\">message_id</span><span class=\"p\">}</span>\n        <span class=\"k\">if</span> <span class=\"n\">root_collection</span><span class=\"p\">:</span>\n            <span class=\"n\">body</span><span class=\"p\">[</span><span class=\"s2\">\"root_collection\"</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"n\">root_collection</span>\n        <span class=\"n\">resp</span> <span class=\"o\">=</span> <span class=\"n\">httpx</span><span class=\"o\">.</span><span class=\"n\">post</span><span class=\"p\">(</span>\n            <span class=\"sa\">f</span><span class=\"s2\">\"</span><span class=\"si\">{</span><span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">base_url</span><span class=\"si\">}</span><span class=\"s2\">/v1/query/cancel\"</span><span class=\"p\">,</span>\n            <span class=\"n\">json</span><span class=\"o\">=</span><span class=\"n\">body</span><span class=\"p\">,</span>\n            <span class=\"n\">headers</span><span class=\"o\">=</span><span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">_headers</span><span class=\"p\">,</span>\n            <span class=\"n\">timeout</span><span class=\"o\">=</span><span class=\"mi\">30</span><span class=\"p\">,</span>\n        <span class=\"p\">)</span>\n        <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">raise_for_status</span><span class=\"p\">()</span>\n        <span class=\"k\">return</span> <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">json</span><span class=\"p\">()</span></div>\n\n\n    <span class=\"c1\"># \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550</span>\n    <span class=\"c1\"># CODEGEN</span>\n    <span class=\"c1\"># \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550</span>\n\n<div class=\"viewcode-block\" id=\"DocWorm.codegen_health\">\n<a class=\"viewcode-back\" href=\"../../../client/#docworm.client.DocWorm.codegen_health\">[docs]</a>\n    <span class=\"k\">def</span><span class=\"w\"> </span><span class=\"nf\">codegen_health</span><span class=\"p\">(</span><span class=\"bp\">self</span><span class=\"p\">)</span> <span class=\"o\">-&gt;</span> <span class=\"nb\">dict</span><span class=\"p\">:</span>\n<span class=\"w\">        </span><span class=\"sd\">\"\"\"Codegen service health (no auth required).\"\"\"</span>\n        <span class=\"n\">resp</span> <span class=\"o\">=</span> <span class=\"n\">httpx</span><span class=\"o\">.</span><span class=\"n\">get</span><span class=\"p\">(</span><span class=\"sa\">f</span><span class=\"s2\">\"</span><span class=\"si\">{</span><span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">base_url</span><span class=\"si\">}</span><span class=\"s2\">/v1/codegen/health\"</span><span class=\"p\">,</span> <span class=\"n\">timeout</span><span class=\"o\">=</span><span class=\"mi\">10</span><span class=\"p\">)</span>\n        <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">raise_for_status</span><span class=\"p\">()</span>\n        <span class=\"k\">return</span> <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">json</span><span class=\"p\">()</span></div>\n\n\n<div class=\"viewcode-block\" id=\"DocWorm.generate_code\">\n<a class=\"viewcode-back\" href=\"../../../client/#docworm.client.DocWorm.generate_code\">[docs]</a>\n    <span class=\"k\">def</span><span class=\"w\"> </span><span class=\"nf\">generate_code</span><span class=\"p\">(</span>\n        <span class=\"bp\">self</span><span class=\"p\">,</span>\n        <span class=\"n\">chat_id</span><span class=\"p\">:</span> <span class=\"nb\">str</span><span class=\"p\">,</span>\n        <span class=\"n\">file_id</span><span class=\"p\">:</span> <span class=\"nb\">str</span><span class=\"p\">,</span>\n        <span class=\"n\">task</span><span class=\"p\">:</span> <span class=\"nb\">str</span> <span class=\"o\">=</span> <span class=\"s2\">\"excel_index\"</span><span class=\"p\">,</span>\n        <span class=\"n\">prompt</span><span class=\"p\">:</span> <span class=\"n\">Optional</span><span class=\"p\">[</span><span class=\"nb\">str</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"kc\">None</span><span class=\"p\">,</span>\n        <span class=\"n\">output_hint</span><span class=\"p\">:</span> <span class=\"n\">Optional</span><span class=\"p\">[</span><span class=\"nb\">str</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"kc\">None</span><span class=\"p\">,</span>\n        <span class=\"n\">entity_context</span><span class=\"p\">:</span> <span class=\"n\">Optional</span><span class=\"p\">[</span><span class=\"nb\">str</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"kc\">None</span><span class=\"p\">,</span>\n        <span class=\"n\">exhaustive</span><span class=\"p\">:</span> <span class=\"n\">Optional</span><span class=\"p\">[</span><span class=\"nb\">bool</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"kc\">None</span><span class=\"p\">,</span>\n        <span class=\"n\">artifact_name</span><span class=\"p\">:</span> <span class=\"n\">Optional</span><span class=\"p\">[</span><span class=\"nb\">str</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"kc\">None</span><span class=\"p\">,</span>\n    <span class=\"p\">)</span> <span class=\"o\">-&gt;</span> <span class=\"n\">CodegenResponse</span><span class=\"p\">:</span>\n<span class=\"w\">        </span><span class=\"sd\">\"\"\"</span>\n<span class=\"sd\">        Generate (and for excel_index, execute) code for a document.</span>\n<span class=\"sd\">        \"\"\"</span>\n        <span class=\"n\">body</span><span class=\"p\">:</span> <span class=\"nb\">dict</span> <span class=\"o\">=</span> <span class=\"p\">{</span><span class=\"s2\">\"chat_id\"</span><span class=\"p\">:</span> <span class=\"n\">chat_id</span><span class=\"p\">,</span> <span class=\"s2\">\"file_id\"</span><span class=\"p\">:</span> <span class=\"n\">file_id</span><span class=\"p\">,</span> <span class=\"s2\">\"task\"</span><span class=\"p\">:</span> <span class=\"n\">task</span><span class=\"p\">}</span>\n        <span class=\"k\">if</span> <span class=\"n\">prompt</span> <span class=\"ow\">is</span> <span class=\"ow\">not</span> <span class=\"kc\">None</span><span class=\"p\">:</span>\n            <span class=\"n\">body</span><span class=\"p\">[</span><span class=\"s2\">\"prompt\"</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"n\">prompt</span>\n        <span class=\"k\">if</span> <span class=\"n\">output_hint</span> <span class=\"ow\">is</span> <span class=\"ow\">not</span> <span class=\"kc\">None</span><span class=\"p\">:</span>\n            <span class=\"n\">body</span><span class=\"p\">[</span><span class=\"s2\">\"output_hint\"</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"n\">output_hint</span>\n        <span class=\"k\">if</span> <span class=\"n\">entity_context</span> <span class=\"ow\">is</span> <span class=\"ow\">not</span> <span class=\"kc\">None</span><span class=\"p\">:</span>\n            <span class=\"n\">body</span><span class=\"p\">[</span><span class=\"s2\">\"entity_context\"</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"n\">entity_context</span>\n        <span class=\"k\">if</span> <span class=\"n\">exhaustive</span> <span class=\"ow\">is</span> <span class=\"ow\">not</span> <span class=\"kc\">None</span><span class=\"p\">:</span>\n            <span class=\"n\">body</span><span class=\"p\">[</span><span class=\"s2\">\"exhaustive\"</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"n\">exhaustive</span>\n        <span class=\"k\">if</span> <span class=\"n\">artifact_name</span> <span class=\"ow\">is</span> <span class=\"ow\">not</span> <span class=\"kc\">None</span><span class=\"p\">:</span>\n            <span class=\"n\">body</span><span class=\"p\">[</span><span class=\"s2\">\"artifact_name\"</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"n\">artifact_name</span>\n        <span class=\"n\">resp</span> <span class=\"o\">=</span> <span class=\"n\">httpx</span><span class=\"o\">.</span><span class=\"n\">post</span><span class=\"p\">(</span>\n            <span class=\"sa\">f</span><span class=\"s2\">\"</span><span class=\"si\">{</span><span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">base_url</span><span class=\"si\">}</span><span class=\"s2\">/v1/codegen/generate\"</span><span class=\"p\">,</span>\n            <span class=\"n\">json</span><span class=\"o\">=</span><span class=\"n\">body</span><span class=\"p\">,</span>\n            <span class=\"n\">headers</span><span class=\"o\">=</span><span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">_headers</span><span class=\"p\">,</span>\n            <span class=\"n\">timeout</span><span class=\"o\">=</span><span class=\"mi\">300</span><span class=\"p\">,</span>\n        <span class=\"p\">)</span>\n        <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">raise_for_status</span><span class=\"p\">()</span>\n        <span class=\"n\">d</span> <span class=\"o\">=</span> <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">json</span><span class=\"p\">()</span>\n        <span class=\"k\">return</span> <span class=\"n\">CodegenResponse</span><span class=\"p\">(</span>\n            <span class=\"n\">code_id</span><span class=\"o\">=</span><span class=\"n\">d</span><span class=\"o\">.</span><span class=\"n\">get</span><span class=\"p\">(</span><span class=\"s2\">\"code_id\"</span><span class=\"p\">,</span> <span class=\"s2\">\"\"</span><span class=\"p\">),</span>\n            <span class=\"n\">code</span><span class=\"o\">=</span><span class=\"n\">d</span><span class=\"o\">.</span><span class=\"n\">get</span><span class=\"p\">(</span><span class=\"s2\">\"code\"</span><span class=\"p\">,</span> <span class=\"s2\">\"\"</span><span class=\"p\">),</span>\n            <span class=\"n\">explanation</span><span class=\"o\">=</span><span class=\"n\">d</span><span class=\"o\">.</span><span class=\"n\">get</span><span class=\"p\">(</span><span class=\"s2\">\"explanation\"</span><span class=\"p\">,</span> <span class=\"s2\">\"\"</span><span class=\"p\">),</span>\n            <span class=\"n\">run_id</span><span class=\"o\">=</span><span class=\"n\">d</span><span class=\"o\">.</span><span class=\"n\">get</span><span class=\"p\">(</span><span class=\"s2\">\"run_id\"</span><span class=\"p\">),</span>\n            <span class=\"n\">output</span><span class=\"o\">=</span><span class=\"n\">d</span><span class=\"o\">.</span><span class=\"n\">get</span><span class=\"p\">(</span><span class=\"s2\">\"output\"</span><span class=\"p\">)</span> <span class=\"ow\">or</span> <span class=\"p\">{},</span>\n        <span class=\"p\">)</span></div>\n\n\n<div class=\"viewcode-block\" id=\"DocWorm.list_codes\">\n<a class=\"viewcode-back\" href=\"../../../client/#docworm.client.DocWorm.list_codes\">[docs]</a>\n    <span class=\"k\">def</span><span class=\"w\"> </span><span class=\"nf\">list_codes</span><span class=\"p\">(</span><span class=\"bp\">self</span><span class=\"p\">,</span> <span class=\"n\">chat_id</span><span class=\"p\">:</span> <span class=\"nb\">str</span><span class=\"p\">)</span> <span class=\"o\">-&gt;</span> <span class=\"nb\">dict</span><span class=\"p\">:</span>\n<span class=\"w\">        </span><span class=\"sd\">\"\"\"List generated code artifacts for a chat.\"\"\"</span>\n        <span class=\"n\">resp</span> <span class=\"o\">=</span> <span class=\"n\">httpx</span><span class=\"o\">.</span><span class=\"n\">get</span><span class=\"p\">(</span>\n            <span class=\"sa\">f</span><span class=\"s2\">\"</span><span class=\"si\">{</span><span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">base_url</span><span class=\"si\">}</span><span class=\"s2\">/v1/codegen/</span><span class=\"si\">{</span><span class=\"n\">quote</span><span class=\"p\">(</span><span class=\"n\">chat_id</span><span class=\"p\">)</span><span class=\"si\">}</span><span class=\"s2\">/codes\"</span><span class=\"p\">,</span>\n            <span class=\"n\">headers</span><span class=\"o\">=</span><span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">_headers</span><span class=\"p\">,</span>\n            <span class=\"n\">timeout</span><span class=\"o\">=</span><span class=\"mi\">30</span><span class=\"p\">,</span>\n        <span class=\"p\">)</span>\n        <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">raise_for_status</span><span class=\"p\">()</span>\n        <span class=\"k\">return</span> <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">json</span><span class=\"p\">()</span></div>\n\n\n<div class=\"viewcode-block\" id=\"DocWorm.get_code\">\n<a class=\"viewcode-back\" href=\"../../../client/#docworm.client.DocWorm.get_code\">[docs]</a>\n    <span class=\"k\">def</span><span class=\"w\"> </span><span class=\"nf\">get_code</span><span class=\"p\">(</span>\n        <span class=\"bp\">self</span><span class=\"p\">,</span>\n        <span class=\"n\">chat_id</span><span class=\"p\">:</span> <span class=\"nb\">str</span><span class=\"p\">,</span>\n        <span class=\"n\">code_id</span><span class=\"p\">:</span> <span class=\"nb\">str</span><span class=\"p\">,</span>\n        <span class=\"n\">version</span><span class=\"p\">:</span> <span class=\"n\">Optional</span><span class=\"p\">[</span><span class=\"nb\">int</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"kc\">None</span><span class=\"p\">,</span>\n        <span class=\"n\">latest</span><span class=\"p\">:</span> <span class=\"nb\">bool</span> <span class=\"o\">=</span> <span class=\"kc\">False</span><span class=\"p\">,</span>\n    <span class=\"p\">)</span> <span class=\"o\">-&gt;</span> <span class=\"nb\">dict</span><span class=\"p\">:</span>\n<span class=\"w\">        </span><span class=\"sd\">\"\"\"Fetch a persisted code artifact.\"\"\"</span>\n        <span class=\"n\">params</span><span class=\"p\">:</span> <span class=\"nb\">dict</span> <span class=\"o\">=</span> <span class=\"p\">{}</span>\n        <span class=\"k\">if</span> <span class=\"n\">version</span> <span class=\"ow\">is</span> <span class=\"ow\">not</span> <span class=\"kc\">None</span><span class=\"p\">:</span>\n            <span class=\"n\">params</span><span class=\"p\">[</span><span class=\"s2\">\"version\"</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"n\">version</span>\n        <span class=\"k\">if</span> <span class=\"n\">latest</span><span class=\"p\">:</span>\n            <span class=\"n\">params</span><span class=\"p\">[</span><span class=\"s2\">\"latest\"</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"mi\">1</span>\n        <span class=\"n\">resp</span> <span class=\"o\">=</span> <span class=\"n\">httpx</span><span class=\"o\">.</span><span class=\"n\">get</span><span class=\"p\">(</span>\n            <span class=\"sa\">f</span><span class=\"s2\">\"</span><span class=\"si\">{</span><span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">base_url</span><span class=\"si\">}</span><span class=\"s2\">/v1/codegen/</span><span class=\"si\">{</span><span class=\"n\">quote</span><span class=\"p\">(</span><span class=\"n\">chat_id</span><span class=\"p\">)</span><span class=\"si\">}</span><span class=\"s2\">/code/</span><span class=\"si\">{</span><span class=\"n\">quote</span><span class=\"p\">(</span><span class=\"n\">code_id</span><span class=\"p\">)</span><span class=\"si\">}</span><span class=\"s2\">\"</span><span class=\"p\">,</span>\n            <span class=\"n\">params</span><span class=\"o\">=</span><span class=\"n\">params</span> <span class=\"ow\">or</span> <span class=\"kc\">None</span><span class=\"p\">,</span>\n            <span class=\"n\">headers</span><span class=\"o\">=</span><span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">_headers</span><span class=\"p\">,</span>\n            <span class=\"n\">timeout</span><span class=\"o\">=</span><span class=\"mi\">30</span><span class=\"p\">,</span>\n        <span class=\"p\">)</span>\n        <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">raise_for_status</span><span class=\"p\">()</span>\n        <span class=\"k\">return</span> <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">json</span><span class=\"p\">()</span></div>\n\n\n<div class=\"viewcode-block\" id=\"DocWorm.put_code\">\n<a class=\"viewcode-back\" href=\"../../../client/#docworm.client.DocWorm.put_code\">[docs]</a>\n    <span class=\"k\">def</span><span class=\"w\"> </span><span class=\"nf\">put_code</span><span class=\"p\">(</span>\n        <span class=\"bp\">self</span><span class=\"p\">,</span>\n        <span class=\"n\">chat_id</span><span class=\"p\">:</span> <span class=\"nb\">str</span><span class=\"p\">,</span>\n        <span class=\"n\">code_id</span><span class=\"p\">:</span> <span class=\"nb\">str</span><span class=\"p\">,</span>\n        <span class=\"n\">code</span><span class=\"p\">:</span> <span class=\"nb\">str</span><span class=\"p\">,</span>\n        <span class=\"n\">explanation</span><span class=\"p\">:</span> <span class=\"nb\">str</span> <span class=\"o\">=</span> <span class=\"s2\">\"\"</span><span class=\"p\">,</span>\n        <span class=\"n\">task</span><span class=\"p\">:</span> <span class=\"nb\">str</span> <span class=\"o\">=</span> <span class=\"s2\">\"\"</span><span class=\"p\">,</span>\n        <span class=\"n\">source</span><span class=\"p\">:</span> <span class=\"nb\">str</span> <span class=\"o\">=</span> <span class=\"s2\">\"\"</span><span class=\"p\">,</span>\n        <span class=\"n\">fork</span><span class=\"p\">:</span> <span class=\"nb\">bool</span> <span class=\"o\">=</span> <span class=\"kc\">False</span><span class=\"p\">,</span>\n        <span class=\"n\">version</span><span class=\"p\">:</span> <span class=\"n\">Optional</span><span class=\"p\">[</span><span class=\"nb\">int</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"kc\">None</span><span class=\"p\">,</span>\n    <span class=\"p\">)</span> <span class=\"o\">-&gt;</span> <span class=\"nb\">dict</span><span class=\"p\">:</span>\n<span class=\"w\">        </span><span class=\"sd\">\"\"\"Persist a modified code artifact (fork=True forks to a new id).\"\"\"</span>\n        <span class=\"n\">params</span><span class=\"p\">:</span> <span class=\"nb\">dict</span> <span class=\"o\">=</span> <span class=\"p\">{}</span>\n        <span class=\"k\">if</span> <span class=\"n\">fork</span><span class=\"p\">:</span>\n            <span class=\"n\">params</span><span class=\"p\">[</span><span class=\"s2\">\"fork\"</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"mi\">1</span>\n        <span class=\"k\">if</span> <span class=\"n\">version</span> <span class=\"ow\">is</span> <span class=\"ow\">not</span> <span class=\"kc\">None</span><span class=\"p\">:</span>\n            <span class=\"n\">params</span><span class=\"p\">[</span><span class=\"s2\">\"version\"</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"n\">version</span>\n        <span class=\"n\">body</span><span class=\"p\">:</span> <span class=\"nb\">dict</span> <span class=\"o\">=</span> <span class=\"p\">{</span><span class=\"s2\">\"code\"</span><span class=\"p\">:</span> <span class=\"n\">code</span><span class=\"p\">,</span> <span class=\"s2\">\"explanation\"</span><span class=\"p\">:</span> <span class=\"n\">explanation</span><span class=\"p\">,</span> <span class=\"s2\">\"task\"</span><span class=\"p\">:</span> <span class=\"n\">task</span><span class=\"p\">}</span>\n        <span class=\"k\">if</span> <span class=\"n\">source</span><span class=\"p\">:</span>\n            <span class=\"n\">body</span><span class=\"p\">[</span><span class=\"s2\">\"source\"</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"n\">source</span>\n        <span class=\"n\">resp</span> <span class=\"o\">=</span> <span class=\"n\">httpx</span><span class=\"o\">.</span><span class=\"n\">put</span><span class=\"p\">(</span>\n            <span class=\"sa\">f</span><span class=\"s2\">\"</span><span class=\"si\">{</span><span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">base_url</span><span class=\"si\">}</span><span class=\"s2\">/v1/codegen/</span><span class=\"si\">{</span><span class=\"n\">quote</span><span class=\"p\">(</span><span class=\"n\">chat_id</span><span class=\"p\">)</span><span class=\"si\">}</span><span class=\"s2\">/code/</span><span class=\"si\">{</span><span class=\"n\">quote</span><span class=\"p\">(</span><span class=\"n\">code_id</span><span class=\"p\">)</span><span class=\"si\">}</span><span class=\"s2\">\"</span><span class=\"p\">,</span>\n            <span class=\"n\">params</span><span class=\"o\">=</span><span class=\"n\">params</span> <span class=\"ow\">or</span> <span class=\"kc\">None</span><span class=\"p\">,</span>\n            <span class=\"n\">json</span><span class=\"o\">=</span><span class=\"n\">body</span><span class=\"p\">,</span>\n            <span class=\"n\">headers</span><span class=\"o\">=</span><span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">_headers</span><span class=\"p\">,</span>\n            <span class=\"n\">timeout</span><span class=\"o\">=</span><span class=\"mi\">60</span><span class=\"p\">,</span>\n        <span class=\"p\">)</span>\n        <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">raise_for_status</span><span class=\"p\">()</span>\n        <span class=\"k\">return</span> <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">json</span><span class=\"p\">()</span></div>\n\n\n<div class=\"viewcode-block\" id=\"DocWorm.predict\">\n<a class=\"viewcode-back\" href=\"../../../client/#docworm.client.DocWorm.predict\">[docs]</a>\n    <span class=\"k\">def</span><span class=\"w\"> </span><span class=\"nf\">predict</span><span class=\"p\">(</span><span class=\"bp\">self</span><span class=\"p\">,</span> <span class=\"n\">body</span><span class=\"p\">:</span> <span class=\"nb\">dict</span><span class=\"p\">)</span> <span class=\"o\">-&gt;</span> <span class=\"nb\">dict</span><span class=\"p\">:</span>\n<span class=\"w\">        </span><span class=\"sd\">\"\"\"Forward a tabular prediction request to the predictor service.\"\"\"</span>\n        <span class=\"n\">resp</span> <span class=\"o\">=</span> <span class=\"n\">httpx</span><span class=\"o\">.</span><span class=\"n\">post</span><span class=\"p\">(</span>\n            <span class=\"sa\">f</span><span class=\"s2\">\"</span><span class=\"si\">{</span><span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">base_url</span><span class=\"si\">}</span><span class=\"s2\">/v1/codegen/predict\"</span><span class=\"p\">,</span>\n            <span class=\"n\">json</span><span class=\"o\">=</span><span class=\"n\">body</span><span 